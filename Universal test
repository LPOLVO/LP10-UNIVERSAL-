            -- Script name
            mkLabel(card, {
                Size     = UDim2.new(1, -100, 0, 22),
                Position = UDim2.new(0, 62, 0, 10),
                Text     = d.N,
                TextColor3 = C.white,
                Font     = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                ZIndex   = 9,
