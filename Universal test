    lbl.TextSize        = 13
    lbl.TextColor3      = C.text
    lbl.TextXAlignment  = Enum.TextXAlignment.Left
    lbl.ZIndex          = 13

    -- Track
    local track = Instance.new("Frame", f)
    track.Size          = UDim2.new(0, 40, 0, 20)
    track.Position      = UDim2.new(1, -52, 0.5, -10)
    track.BackgroundColor3 = state and C.accent or C.dim
    track.ZIndex        = 13
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 10)

    -- Knob
    local knob = Instance.new("Frame", track)
    knob.Size           = UDim2.new(0, 14, 0, 14)
    knob.Position       = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.ZIndex         = 14
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 7)

    -- status label
    local statusLbl = Instance.new("TextLabel", f)
    statusLbl.Size          = UDim2.new(0, 40, 0, 14)
    statusLbl.Position      = UDim2.new(1, -52, 0, 3)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text          = state and "ON" or "OFF"
    statusLbl.Font          = Enum.Font.GothamBold
    statusLbl.TextSize      = 8
    statusLbl.TextColor3    = state and C.green or C.muted
    statusLbl.ZIndex        = 14

    local clickBtn = Instance.new("TextButton", f)
    clickBtn.Size           = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text           = ""
    clickBtn.ZIndex         = 15
    clickBtn.AutoButtonColor = false

    local function update()
        tw(track, 0.2, {BackgroundColor3 = state and C.accent or C.dim})
        tw(knob,  0.2, {Position = state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7)})
        tw(statusLbl, 0.15, {TextColor3 = state and C.green or C.muted})
        statusLbl.Text = state and "ON" or "OFF"
        tw(fs, 0.2, {Color = state and C.accent or C.line})
    end

    clickBtn.MouseButton1Click:Connect(function()
        state = not state
        update()
        pcall(callback, state)
    end)

    update()
    return {
        GetValue = function() return state end,
        SetValue = function(v) state = v; update(); pcall(callback, state) end,
    }
end

