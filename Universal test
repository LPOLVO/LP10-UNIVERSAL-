        Position       = UDim2.fromOffset(28, 36),
        Text           = data.msg,
        TextColor3     = C.text,
        Font           = Enum.Font.Gotham,
        TextSize       = 11,
        TextWrapped    = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 121,
    })
    play("notif")
    tw(card, 0.36, {Position = UDim2.new(1, -338, 1, -100)})
    task.delay(3.4, function()
        if card and card.Parent then
            tw(card, 0.28, {Position = UDim2.new(1, 20, 1, -100)}, nil, Enum.EasingDirection.In)
            task.wait(0.32)
            pcall(function() card:Destroy() end)
        end
        task.wait(0.12)
        showNextToast()
    end)
end

local function toast(title, msg, col)
    table.insert(toastQueue, {title=title, msg=msg, col=col})
    if not toastActive then showNextToast() end
end

