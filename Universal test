local function addSlider(parent, text, min, max, default, callback)
    min      = min      or 0
    max      = max      or 100
    default  = default  or min
    callback = callback or function() end

    local value = default
    local f     = Instance.new("Frame", parent)
    f.Size              = UDim2.new(1, 0, 0, 52)
    f.BackgroundColor3  = C.panel
    f.ZIndex            = 12
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    local fs = Instance.new("UIStroke", f)
    fs.Color            = C.line
    fs.Thickness        = 1

    local header = Instance.new("Frame", f)
    header.Size         = UDim2.new(1, 0, 0, 26)
    header.BackgroundTransparency = 1
    header.ZIndex       = 13

    local lbl = Instance.new("TextLabel", header)
    lbl.Size            = UDim2.new(1, -50, 1, 0)
    lbl.Position        = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text            = text
    lbl.Font            = Enum.Font.GothamSemibold
    lbl.TextSize        = 13
    lbl.TextColor3      = C.text
    lbl.TextXAlignment  = Enum.TextXAlignment.Left
    lbl.ZIndex          = 13

    local valLbl = Instance.new("TextLabel", header)
    valLbl.Size         = UDim2.new(0, 44, 1, 0)
    valLbl.Position     = UDim2.new(1, -54, 0, 0)
    valLbl.BackgroundColor3 = C.accentDark
    valLbl.Text         = tostring(value)
    valLbl.Font         = Enum.Font.GothamBold
    valLbl.TextSize     = 11
    valLbl.TextColor3   = C.glow
    valLbl.ZIndex       = 13
    Instance.new("UICorner", valLbl).CornerRadius = UDim.new(0, 5)

    -- Track
    local trackBg = Instance.new("Frame", f)
    trackBg.Size        = UDim2.new(1, -24, 0, 6)
    trackBg.Position    = UDim2.new(0, 12, 0, 34)
    trackBg.BackgroundColor3 = C.dim
    trackBg.ZIndex      = 13
    Instance.new("UICorner", trackBg).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame", trackBg)
    fill.Size           = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = C.accent
    fill.ZIndex         = 14
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local knob = Instance.new("Frame", trackBg)
    knob.Size           = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint    = Vector2.new(0.5, 0.5)
    knob.Position       = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.ZIndex         = 15
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 7)
    local ks = Instance.new("UIStroke", knob)
    ks.Color    = C.accent
    ks.Thickness = 2

    local draggingSlider = false
    trackBg.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if draggingSlider and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local abs = trackBg.AbsolutePosition
            local sz  = trackBg.AbsoluteSize
            local pct = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
            value = math.round(min + (max - min) * pct)
            fill.Size  = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text = tostring(value)
            pcall(callback, value)
        end
    end)

    return {
        GetValue = function() return value end,
        SetValue = function(v)
            value = math.clamp(math.round(v), min, max)
            local pct = (value - min) / (max - min)
            fill.Size  = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text = tostring(value)
            pcall(callback, value)
        end,
    }
end

