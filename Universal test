-- PARTICLE SYSTEM
-- ════════════════════════════════════════════════════════════
local particles = {}

local function spawnParticle(parent, zidx)
    if Settings.reduceMotion or Settings.performanceMode or not Settings.particles then return end
    local vp = getVP()
    local size = math.random(2, 5)
    local p = mkFrame(parent, {
        Size = UDim2.new(0, size, 0, size),
        Position = UDim2.new(math.random(), 0, math.random(), 0),
        BackgroundColor3 = math.random() > 0.5 and C.royal or C.electric,
        ZIndex = zidx or 2,
    })
    corner(p, size)
    p.BackgroundTransparency = 0.4

    table.insert(particles, p)

    local function floatLoop()
        if not p or not p.Parent then return end
        local tx = math.random() * vp.X
        local ty = math.random() * vp.Y
        tw(p, math.random(3, 7), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut,
           {Position = UDim2.new(0, tx, 0, ty), BackgroundTransparency = math.random() > 0.5 and 0.3 or 0.7})
        task.delay(math.random(3, 7) + 0.1, function()
            if p and p.Parent then floatLoop() end
        end)
    end
    task.spawn(floatLoop)
end

local function clearParticles()
    for _, p in ipairs(particles) do
        pcall(function() p:Destroy() end)
    end
    particles = {}
end

