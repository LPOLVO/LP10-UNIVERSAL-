-- INSTANCE HELPERS
-- ════════════════════════════════════════════════════════════════════════════
local function prop(obj, values)
    for k, v in pairs(values or {}) do obj[k] = v end
    return obj
end

local function new(class, parent, values)
    local obj = Instance.new(class)
    obj.Parent = parent
    return prop(obj, values)
end

local function frame(parent, values)
    local obj = new("Frame", parent, values)
    obj.BorderSizePixel = 0
    return obj
end

local ElectricTargets = {}
local RGBTargets = {}

local function label(parent, values)
    local obj = new("TextLabel", parent, values)
    obj.BackgroundTransparency = 1
    obj.TextWrapped = (values and values.TextWrapped) or false
    obj.TextStrokeColor3 = C.electric
    obj.TextStrokeTransparency = 0.6
    table.insert(ElectricTargets, obj)
    return obj
end

local function button(parent, values)
    local obj = new("TextButton", parent, values)
    obj.AutoButtonColor = false
    obj.BorderSizePixel = 0
    obj.TextStrokeColor3 = C.electric
    obj.TextStrokeTransparency = 0.6
    table.insert(ElectricTargets, obj)
    return obj
end

local function input(parent, values)
    local obj = new("TextBox", parent, values)
    obj.BorderSizePixel = 0
    obj.ClearTextOnFocus = false
    return obj
end

local function round(obj, r)
    return new("UICorner", obj, {CornerRadius = UDim.new(0, r or 12)})
end

local function outline(obj, col, th, trans)
    return new("UIStroke", obj, {
        Color = col or C.line,
        Thickness = th or 1,
        Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function fillGradient(obj, c0, c1, rot)
    return new("UIGradient", obj, {
        Color = ColorSequence.new(c0, c1),
        Rotation = rot or 90,
    })
end

local function transGradient(obj, t0, t1, rot)
    return new("UIGradient", obj, {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, t0),
            NumberSequenceKeypoint.new(1, t1),
        }),
        Rotation = rot or 90,
    })
end

local function inset(obj, l, r, t, b)
    return new("UIPadding", obj, {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    })
end

local function listLayout(parent, dir, pad, sort)
    return new("UIListLayout", parent, {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding       = UDim.new(0, pad or 10),
        SortOrder     = sort or Enum.SortOrder.LayoutOrder,
    })
end

local GLOW_IMG = "rbxassetid://5028857084"

local function glow(parent, size, col, trans, pos)
    return new("ImageLabel", parent, {
        Image = GLOW_IMG,
        ImageColor3 = col or C.royal,
        ImageTransparency = trans or 0.7,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        Position = pos or UDim2.new(0.5, -size/2, 0.5, -size/2),
        ZIndex = 1,
    })
end

-- ════════════════════════════════════════════════════════════════════════════
-- TWEEN HELPERS
-- ════════════════════════════════════════════════════════════════════════════
local function tw(obj, dur, props, sty, dir)
    local t = Settings.reduceMotion and math.min(dur, 0.12) or dur
    local info = TweenInfo.new(t, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    TweenService:Create(obj, info, props):Play()
end

local function spring(obj, dur, props)
    tw(obj, dur, props, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function sine(obj, dur, props)
    tw(obj, dur, props, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

