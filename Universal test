    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 13
    lbl.TextColor3 = TEXT
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 13
    local track = Instance.new("Frame", f)
    track.Size = UDim2.new(0, 38, 0, 19)
    track.Position = UDim2.new(1, -48, 0.5, -9)
    track.BackgroundColor3 = state and ACCENT or Color3.fromRGB(50, 30, 80)
    track.ZIndex = 13
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 9)
    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.new(0, 13, 0, 13)
    knob.Position = state and UDim2.new(1, -16, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
    knob.BackgroundColor3 = WHITE
    knob.ZIndex = 14
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 6)
    local click = Instance.new("TextButton", f)
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 15
    click.AutoButtonColor = false
    local function update()
        tw(track, 0.18, {BackgroundColor3 = state and ACCENT or Color3.fromRGB(50, 30, 80)})
        tw(knob, 0.18, {Position = state and UDim2.new(1, -16, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
        tw(stroke, 0.18, {Color = state and ACCENT or LINE})
    end
    click.MouseButton1Click:Connect(function()
        state = not state
        update()
        pcall(cb, state)
    end)
    update()
    return {Get = function() return state end, Set = function(v) state = v update() pcall(cb, state) end}
end

local function slider(parent, text, min, max, default, cb)
    min = min or 0
