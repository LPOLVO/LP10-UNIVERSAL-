--  TAB SYSTEM
-- 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
local tabs          = {}
local tabPages      = {}
local activeTab     = nil

local function createTab(name, icon)
    icon = icon or ""

    -- Tab button
    local btn = Instance.new("TextButton", TabBar)
    btn.Name                = name
    btn.Size                = UDim2.new(0, 0, 1, 0)
    btn.AutomaticSize       = Enum.AutomaticSize.X
    btn.BackgroundTransparency = 1
    btn.Text                = (icon ~= "" and icon.." " or "") .. name
    btn.Font                = Enum.Font.GothamSemibold
    btn.TextSize            = 12
    btn.TextColor3          = C.muted
    btn.ZIndex              = 12
    btn.AutoButtonColor     = false
    Instance.new("UIPadding", btn).PaddingLeft  = UDim.new(0, 12)
    Instance.new("UIPadding", btn).PaddingRight = UDim.new(0, 12)

    -- active indicator
    local ind = Instance.new("Frame", btn)
    ind.Name            = "Indicator"
    ind.Size            = UDim2.new(0.8, 0, 0, 2)
    ind.Position        = UDim2.new(0.1, 0, 1, -2)
    ind.BackgroundColor3 = C.accent
    ind.BackgroundTransparency = 1
    ind.ZIndex          = 13
    Instance.new("UICorner", ind).CornerRadius = UDim.new(0, 1)

    -- Page container (hidden by default)
    local page = Instance.new("Frame", ContentScroll)
    page.Name               = "Page_"..name
    page.Size               = UDim2.new(1, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.AutomaticSize      = Enum.AutomaticSize.Y
    page.Visible            = false
    page.ZIndex             = 11
    local pageLayout = Instance.new("UIListLayout", page)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding   = UDim.new(0, 6)

    tabPages[name] = page

    local function activate()
        -- deactivate all
        for tName, tPage in pairs(tabPages) do
            tPage.Visible = false
            local tBtn = TabBar:FindFirstChild(tName)
            if tBtn then
                tw(tBtn, 0.15, {TextColor3 = C.muted})
                local tInd = tBtn:FindFirstChild("Indicator")
                if tInd then tw(tInd, 0.15, {BackgroundTransparency = 1}) end
            end
        end
        -- activate this
        page.Visible = true
        tw(btn, 0.15, {TextColor3 = C.white})
        tw(ind, 0.15, {BackgroundTransparency = 0})
        activeTab = name
    end

    btn.MouseButton1Click:Connect(activate)
    tabs[name] = { btn = btn, page = page, activate = activate }

    -- activate first tab automatically
    if not activeTab then activate() end

    return page
end

