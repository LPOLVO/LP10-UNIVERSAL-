local pingVal  = 0
local pingConn = nil

local function startPing(label)
    pingConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            pingVal = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
            if label and label.Parent then
                label.Text = "PING " .. math.round(pingVal) .. "ms"
                label.TextColor3 = pingVal < 80 and C.green or (pingVal < 150 and C.yellow or C.red)
            end
        end)
    end)
end

