-- PREVIEW ACTIONS (NO SCRIPT EXECUTION)
-- ════════════════════════════════════════════════════════════════════════════
local CurrentScript = nil

local function execScript(data)
    if not data then return false end
    toast("Preview only", "This Halloween UI preview contains no runnable scripts.", C.orange)
    return false
end

local function closeDetail()
    play("slide")
    Detail.Visible = true
    tw(Detail, 0.28, {Position=UDim2.new(1,20,0,62)}, nil, Enum.EasingDirection.In)
    task.delay(0.3, function()
        if Detail then Detail.Visible = false end
    end)
end

local function openDetail(data)
    if not data then return end
    CurrentScript = data
    DetailTitle.Text = data.N
    DetailMeta.Text  = (data.Cat or "Universal"):upper().."   /   "..(data.New and "★ NEW" or "CATALOG PREVIEW").."   /   UI ONLY"
    DetailDesc.Text  = "Halloween catalog preview. This entry has no source code and cannot be executed."
    DetailNewBadge.Visible = data.New == true
    local execd = Persist.totalExecs[data.N] or 0
    DetailExecCount.Text = "Preview only • no code payload stored"
    DetailFav.Text = has(Persist.favorites, data.N) and "★  FAVORITED" or "★  FAVORITE"
