    Run.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        Burst(Run.AbsolutePosition + Run.AbsoluteSize / 2, 6)
        Run.Text = "🕯️ ..."
        task.spawn(function()
            local ok = SafeCall(opt.Callback)
            if Run and Run.Parent then
                Run.Text = ok and "👻 DONE" or "☠ CURSED"
                Run.BackgroundColor3 = ok and C.slime or C.red
                task.wait(1.1)
                if Run and Run.Parent then
                    Run.Text = label
                    Run.BackgroundColor3 = C.orange
                end
            end
            busy = false
        end)
    end)

    local entry = Register(card, true)
    return MakeObject(entry, function() return name end, function() SafeCall(opt.Callback) end)
end

-- ───────────── DROPDOWN ─────────────
-- AddDropdown({Name=, Placeholder=, Options={...}, Default=, Callback=})
local function AddDropdown(opt)
    opt = type(opt) == "table" and opt or {Name = tostring(opt)}
    local name = tostring(opt.Name or "Dropdown")
    local placeholder = tostring(opt.Placeholder or ("== Select " .. name .. " =="))
    local options = {}
    for _, v in ipairs(opt.Options or {}) do table.insert(options, tostring(v)) end
    local selected = nil
    local opened = false
    local COLLAPSED = 70
    local OPT_H, OPT_GAP = 26, 4

    local card, cardStroke = Row(COLLAPSED, 0.45)
    card.ClipsDescendants = true

    New("TextLabel", card, {
        Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 6),
        BackgroundTransparency = 1, Text = "🦇 " .. name, TextColor3 = C.text,
        Font = Enum.Font.GothamSemibold, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23,
    })

    local Selector = New("TextButton", card, {
        Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 30),
        BackgroundColor3 = C.field, AutoButtonColor = false,
        Text = placeholder .. "  v", TextColor3 = C.flame,
        Font = Enum.Font.GothamBold, TextSize = 10,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 24,
    })
    Corner(Selector, 8)
    local selStroke = Stroke(Selector, C.orange, 1, 0.4)

    local OptionsFrame = New("Frame", card, {
        Size = UDim2.new(1, -20, 0, 0), Position = UDim2.fromOffset(10, COLLAPSED),
        BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 23,
    })
    New("UIListLayout", OptionsFrame, {Padding = UDim.new(0, OPT_GAP), SortOrder = Enum.SortOrder.LayoutOrder})

    local function OptionsHeight()
        local n = #options
        if n == 0 then return 0 end
        return n * OPT_H + (n - 1) * OPT_GAP
    end

    local function Resize(animate)
        local dur = animate and 0.22 or 0
        local h = opened and OptionsHeight() or 0
        Play(card, dur, {Size = UDim2.new(1, -5, 0, COLLAPSED + (opened and (h + 10) or 0))}):Play()
        Play(OptionsFrame, dur, {Size = UDim2.new(1, -20, 0, h)}):Play()
    end

    local function UpdateText()
        Selector.Text = (selected or placeholder) .. (opened and "  ^" or "  v")
        Selector.TextColor3 = selected and C.text or C.flame
    end

    local function Close()
        opened = false
        UpdateText()
        Resize(true)
    end

    local function Select(value, silent)
        selected = value
        Flags[name] = value
        UpdateText()
        if not silent then SafeCall(opt.Callback, value) end
    end

    local function Rebuild()
        for _, child in ipairs(OptionsFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for index, value in ipairs(options) do
            local b = New("TextButton", OptionsFrame, {
                Size = UDim2.new(1, 0, 0, OPT_H), BackgroundColor3 = C.field,
                AutoButtonColor = false, Text = value, TextColor3 = C.text,
                Font = Enum.Font.GothamSemibold, TextSize = 10,
                TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = index, ZIndex = 24,
            })
            Corner(b, 7)
            local bs = Stroke(b, C.orange, 1, 0.75)
            b.MouseEnter:Connect(function()
                Play(b, 0.12, {BackgroundColor3 = C.cardHot}):Play()
                Play(bs, 0.12, {Transparency = 0.3}):Play()
            end)
            b.MouseLeave:Connect(function()
                Play(b, 0.12, {BackgroundColor3 = C.field}):Play()
                Play(bs, 0.12, {Transparency = 0.75}):Play()
            end)
            b.MouseButton1Click:Connect(function()
                Burst(b.AbsolutePosition + b.AbsoluteSize / 2, 3)
                Select(value)
                Close()
            end)
        end
        if opened then Resize(true) end
    end

    Selector.MouseEnter:Connect(function() Play(selStroke, 0.14, {Transparency = 0.05}):Play() end)
    Selector.MouseLeave:Connect(function() Play(selStroke, 0.14, {Transparency = 0.4}):Play() end)
    Selector.MouseButton1Click:Connect(function()
        opened = not opened
        UpdateText()
        Resize(true)
    end)
    Rebuild()

    if opt.Default ~= nil then
        local found = tostring(opt.Default)
        for _, v in ipairs(options) do
            if v == found then Select(v, false) break end
        end
    end
    Flags[name] = selected

    local entry = Register(card, true, function() Flags[name] = nil end)
    local obj = MakeObject(entry, function() return selected end, function(v, silent)
        if v == nil then
            selected = nil
            Flags[name] = nil
            UpdateText()
        else
            Select(tostring(v), silent)
        end
    end)
    function obj:SetOptions(list)
        options = {}
        for _, v in ipairs(list or {}) do table.insert(options, tostring(v)) end
        local stillValid = false
        for _, v in ipairs(options) do if v == selected then stillValid = true end end
        if not stillValid then selected = nil; Flags[name] = nil; UpdateText() end
        Rebuild()
    end
    return obj
end

-- ───────────── SLIDER ─────────────
-- AddSlider({Name=, Min=, Max=, Default=, Step=, Suffix=, Callback=})
local function AddSlider(opt)
    opt = type(opt) == "table" and opt or {Name = tostring(opt)}
    local name = tostring(opt.Name or "Slider")
    local min, max = tonumber(opt.Min) or 0, tonumber(opt.Max) or 100
    if max <= min then max = min + 1 end
    local step = tonumber(opt.Step) or 1
    local suffix = tostring(opt.Suffix or "")
    local value = math.clamp(tonumber(opt.Default) or min, min, max)

    local card, cardStroke = Row(58)
    RowLabel(card, "🧪 " .. name, 12, 6, {1, -90}, 20, {TextSize = 11})
    local valueLabel = New("TextLabel", card, {
        Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -82, 0, 6),
        BackgroundTransparency = 1, Text = "", TextColor3 = C.flame,
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 23,
    })

    local track = New("Frame", card, {
        Size = UDim2.new(1, -28, 0, 8), Position = UDim2.fromOffset(14, 38),
        BackgroundColor3 = C.off, BorderSizePixel = 0, ZIndex = 23,
    })
    Corner(track, 4)
    local fill = New("Frame", track, {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.orange,
        BorderSizePixel = 0, ZIndex = 24,
    })
    Corner(fill, 4)
    Gradient(fill, C.orange, C.slime, 0)
    local knob = New("Frame", track, {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.text,
        BorderSizePixel = 0, ZIndex = 25,
    })
    Corner(knob, 7)
    Stroke(knob, C.orange, 1.2, 0.1)

    local hit = New("TextButton", card, {
        Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 28),
        BackgroundTransparency = 1, Text = "", ZIndex = 27,
    })

    local function Visual()
        local rel = (value - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        local shown = (step % 1 == 0) and tostring(math.floor(value + 0.5)) or string.format("%.2f", value)
        valueLabel.Text = shown .. suffix
    end
    Visual()
    Flags[name] = value

    local function SetValue(v, silent)
        v = math.clamp(tonumber(v) or min, min, max)
        v = math.floor((v - min) / step + 0.5) * step + min
        v = math.clamp(v, min, max)
        if v == value then return end
        value = v
        Flags[name] = value
        Visual()
        if not silent then SafeCall(opt.Callback, value) end
    end

    local function FromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local rel = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        SetValue(min + (max - min) * rel)
    end

    local dragging = false
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            List.ScrollingEnabled = false
            Play(cardStroke, 0.12, {Transparency = 0.15}):Play()
            FromX(input.Position.X)
        end
    end)
    local sliderConns = {}
    table.insert(sliderConns, Track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            FromX(input.Position.X)
        end
    end)))
    table.insert(sliderConns, Track(UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            List.ScrollingEnabled = true
            Play(cardStroke, 0.12, {Transparency = 0.55}):Play()
        end
    end)))

    local entry = Register(card, true, function()
        Flags[name] = nil
        List.ScrollingEnabled = true
        for _, c in ipairs(sliderConns) do pcall(function() c:Disconnect() end) end
    end)
    return MakeObject(entry, function() return value end, function(v, silent) SetValue(v, silent) end)
end

