-- SCRIPTS STATISTICS PAGE  (detailed execution analytics)
-- ════════════════════════════════════════════════════════════════════════════
local function buildStats()
    PageTitle.Text = "Preview Stats"
    PageSub.Text   = "Your complete LP10 execution history."

    local total = Persist.execCount or 0
    local favC  = #Persist.favorites
    local pinC  = #Persist.pinned
    local recC  = #Persist.recent

    -- Top row
    local topRow = frame(Body, {
        Size=UDim2.new(1,0,0,76), BackgroundTransparency=1, LayoutOrder=1, ZIndex=16,
    })
    listLayout(topRow, Enum.FillDirection.Horizontal, 12)
    statBox(topRow, "OFF", "EXECUTION DISABLED", C.muted, 1)
    statBox(topRow, tostring(favC),  "FAVORITES",        C.yellow,   2)
    statBox(topRow, tostring(recC),  "RECENT",           C.green,    3)

    sectionTitle(Body, "CATALOG ENTRIES", 2)

    -- Sort by exec count
    local sorted = {}
    for n, cnt in pairs(Persist.totalExecs or {}) do
        table.insert(sorted, {name=n, count=cnt})
    end
    table.sort(sorted, function(a,b) return a.count > b.count end)

    if #sorted == 0 then
        label(Body, {
            Size=UDim2.new(1,0,0,50), LayoutOrder=3,
            Text="Execution history is not available in this UI-only preview.",
            TextColor3=C.muted, Font=Enum.Font.Gotham, TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=16,
        })
    else
        for i = 1, math.min(10, #sorted) do
            local s = sorted[i]
            local row = frame(Body, {
                Size=UDim2.new(1,0,0,52), BackgroundColor3=C.card,
                LayoutOrder=2+i, ZIndex=16,
            })
            round(row, 13)
            outline(row, C.line, 1)
            fillGradient(row, Color3.fromRGB(20,10,12), C.card, 135)
            label(row, {
                Size=UDim2.fromOffset(28,52), Position=UDim2.fromOffset(10,0),
                Text=tostring(i)..".",
                TextColor3=i==1 and C.yellow or (i==2 and C.ice or C.muted),
                Font=Enum.Font.GothamBold, TextSize=11, ZIndex=17,
            })
            label(row, {
                Size=UDim2.new(1,-110,0,22), Position=UDim2.fromOffset(38,8),
                Text=s.name, TextColor3=C.white, Font=Enum.Font.GothamBold, TextSize=12,
                TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=17,
            })
            label(row, {
                Size=UDim2.new(1,-110,0,16), Position=UDim2.fromOffset(38,30),
                Text="Previewed "..s.count.." time"..(s.count>1 and "s" or ""),
                TextColor3=C.muted, Font=Enum.Font.Gotham, TextSize=9,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=17,
            })
            label(row, {
                Size=UDim2.fromOffset(80,52), Position=UDim2.new(1,-90,0,0),
                Text=tostring(s.count).."×",
                TextColor3=C.electric, Font=Enum.Font.GothamBold, TextSize=18,
                ZIndex=17,
            })
        end
    end

    sectionTitle(Body, "ACHIEVEMENTS UNLOCKED", 14)
    local achCount = 0
    for k, v in pairs(Persist) do
        if k:sub(1,4) == "ach_" and v == true then
            achCount = achCount + 1
            label(Body, {
                Size=UDim2.new(1,0,0,28), LayoutOrder=14+achCount,
                Text="🏆  "..k:sub(5),
                TextColor3=C.yellow, Font=Enum.Font.GothamBold, TextSize=11,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=16,
            })
        end
    end
    if achCount == 0 then
        label(Body, {
            Size=UDim2.new(1,0,0,28), LayoutOrder=15,
            Text="Achievements are disabled in this UI-only preview.",
            TextColor3=C.muted, Font=Enum.Font.Gotham, TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=16,
        })
    end
end

