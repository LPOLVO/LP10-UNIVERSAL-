    Instance.new("UICorner", selBtn).CornerRadius = UDim.new(0, 5)
    local list = Instance.new("Frame", wrapper)
    list.Size = UDim2.new(1, 0, 0, 0)
    list.Position = UDim2.new(0, 0, 0, 38)
    list.BackgroundColor3 = CARD
    list.ZIndex = 30
    list.ClipsDescendants = true
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 7)
    local ls = Instance.new("UIStroke", list)
    ls.Color = ACCENT
    ls.Thickness = 1
    ls.Transparency = 0.5
    local listLayout = Instance.new("UIListLayout", list)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton", list)
        ob.Size = UDim2.new(1, 0, 0, 28)
        ob.BackgroundTransparency = 1
        ob.Text = opt
        ob.Font = Enum.Font.Gotham
        ob.TextSize = 12
        ob.TextColor3 = opt == selected and WHITE or TEXT
        ob.ZIndex = 31
        ob.AutoButtonColor = false
        ob.MouseEnter:Connect(function() tw(ob, 0.1, {TextColor3 = WHITE}) end)
        ob.MouseLeave:Connect(function() tw(ob, 0.1, {TextColor3 = opt == selected and WHITE or TEXT}) end)
        ob.MouseButton1Click:Connect(function()
            selected = opt
            selBtn.Text = opt .. " v"
            list:TweenSize(UDim2.new(1, 0, 0, 0), "In", "Quart", 0.15, true)
            open = false
            tw(stroke, 0.12, {Color = LINE})
            pcall(cb, selected)
        end)
    end
    selBtn.MouseButton1Click:Connect(function()
        open = not open
        local h = open and (#options * 28) or 0
        list:TweenSize(UDim2.new(1, 0, 0, h), open and "Out" or "In", "Quart", 0.18, true)
        tw(stroke, 0.12, {Color = open and ACCENT or LINE})
    end)
    return {Get = function() return selected end}
end

local function label(parent, text)
    local lbl = Instance.new("TextLabel", parent)
    lbl.Size = UDim2.new(1, 0, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = MUTED
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 12
    Instance.new("UIPadding", lbl).PaddingLeft = UDim.new(0, 4)
    return lbl
end

local function divider(parent)
    local d = Instance.new("Frame", parent)
    d.Size = UDim2.new(1, 0, 0, 1)
    d.BackgroundColor3 = LINE
    d.ZIndex = 12
    return d
end

