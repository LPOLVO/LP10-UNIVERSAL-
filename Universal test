    stroke.Color = LINE
    stroke.Thickness = 1
    local btn = Instance.new("TextButton", f)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextColor3 = TEXT
    btn.ZIndex = 13
    btn.AutoButtonColor = false
    btn.MouseEnter:Connect(function()
        tw(f, 0.12, {BackgroundColor3 = Color3.fromRGB(30, 18, 62)})
        tw(stroke, 0.12, {Color = ACCENT})
        tw(btn, 0.12, {TextColor3 = WHITE})
    end)
    btn.MouseLeave:Connect(function()
        tw(f, 0.12, {BackgroundColor3 = CARD})
        tw(stroke, 0.12, {Color = LINE})
        tw(btn, 0.12, {TextColor3 = TEXT})
    end)
    btn.MouseButton1Click:Connect(function()
        tw(f, 0.07, {BackgroundColor3 = ACCENT})
        task.wait(0.07)
        tw(f, 0.12, {BackgroundColor3 = CARD})
        pcall(cb)
    end)
    return btn
end

local function toggle(parent, text, default, cb)
