local Items = {}          -- every row that was added (for Clear / counting)
local Flags = {}          -- Flags["Feature Name"] = current value
local layoutOrder = 0
local iconIndex = 0
local EmptyCard
local RefreshFooter

local function NextIcon()
    iconIndex = iconIndex % #ICONS + 1
    return ICONS[iconIndex]
end

local function NextOrder()
    layoutOrder = layoutOrder + 1
    return layoutOrder
end

local function PopIn(card)
    local scale = New("UIScale", card, {Scale = 0.85})
    Play(scale, 0.25, {Scale = 1}, Enum.EasingStyle.Back):Play()
end

local function Register(card, isFeature, onDestroy)
    local entry = {Card = card, Feature = isFeature, OnDestroy = onDestroy}
    table.insert(Items, entry)
    if EmptyCard then
        EmptyCard:Destroy()
        EmptyCard = nil
    end
    RefreshFooter()
    return entry
end

local function Row(height, transparency)
    local card = New("Frame", List, {
        Size = UDim2.new(1, -5, 0, height),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        LayoutOrder = NextOrder(),
        ZIndex = 21,
    })
    Corner(card, 11)
    local stroke = Stroke(card, C.orange, 1, transparency or 0.55)
    Gradient(card, C.cardHot, C.card, 135)
    PopIn(card)
    return card, stroke
end

local function RowLabel(card, text, x, y, w, h, extra)
    local props = {
        Size = UDim2.new(w[1], w[2], 0, h),
        Position = UDim2.fromOffset(x, y),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 23,
    }
    for k, v in pairs(extra or {}) do props[k] = v end
    return New("TextLabel", card, props)
end

local function MakeObject(entry, getter, setter)
    local obj = {}
    function obj:Get() return getter and getter() end
    function obj:Set(...) if setter then setter(...) end end
    function obj:Destroy()
        for i, e in ipairs(Items) do
            if e == entry then table.remove(Items, i) break end
        end
        if entry.OnDestroy then entry.OnDestroy() end
        if entry.Card then entry.Card:Destroy() end
        RefreshFooter()
    end
    return obj
end

