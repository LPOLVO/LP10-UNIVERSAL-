    })
    task.spawn(function()
        local frames2 = {"Loading   ","Loading.  ","Loading.. ","Loading..."}
        local fi = 1
        while dots and dots.Parent do
            dots.Text = frames2[fi]
            fi = fi % #frames2 + 1
            task.wait(0.28)
        end
    end)
    return dots
end

