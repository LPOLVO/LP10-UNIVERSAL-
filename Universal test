-- ───────────── SAFE, READ-ONLY EGG MONITOR ─────────────
-- Scans only named egg models that are on-screen, unobstructed, and nearby.
-- It does not invoke game remotes, move the player, or modify game state.
local EggMonitorWorkspace = game:GetService("Workspace")
local EggMonitorPlayers = game:GetService("Players")
local EggMonitorPlayer = EggMonitorPlayers.LocalPlayer
local EggMonitorMaxDistance = 250
local EggMonitorMaxRows = 6

Library.AddSection("VISIBLE EGG INFO")
Library.AddLabel("Read-only: nearby egg-named models in view with a clear line of sight.")
local EggMonitorStatus = Library.AddLabel("Press CHECK to scan visible eggs.")
local EggMonitorRows = {}
for i = 1, EggMonitorMaxRows do
    EggMonitorRows[i] = Library.AddLabel("")
end

Library.AddButton({
    Name = "Refresh Visible Eggs",
    Icon = "🥚",
    Text = "🔎 CHECK",
    Callback = function()
        local camera = EggMonitorWorkspace.CurrentCamera
        if not camera then
            EggMonitorStatus:Set("Camera is not available.")
            return
        end

        local character = EggMonitorPlayer and EggMonitorPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local origin = camera.CFrame.Position
        local referencePosition = root and root.Position or origin
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = character and {character} or {}
        rayParams.IgnoreWater = true

        local matches = {}
        for _, candidate in ipairs(EggMonitorWorkspace:GetDescendants()) do
            if candidate:IsA("Model") and candidate.Parent
                and string.find(string.lower(candidate.Name), "egg", 1, true) then
                local ok, pivot = pcall(function()
                    return candidate:GetPivot()
                end)
                if ok and pivot then
                    local position = pivot.Position
                    local distance = (position - referencePosition).Magnitude
                    if distance <= EggMonitorMaxDistance then
                        local screenPoint, onScreen = camera:WorldToViewportPoint(position)
                        if onScreen and screenPoint.Z > 0 then
                            local direction = position - origin
                            local hit = EggMonitorWorkspace:Raycast(origin, direction, rayParams)
                            if hit and hit.Instance and hit.Instance:IsDescendantOf(candidate) then
                                table.insert(matches, {Name = candidate.Name, Distance = distance})
                            end
                        end
                    end
                end
            end
        end

        table.sort(matches, function(a, b)
            return a.Distance < b.Distance
        end)
        EggMonitorStatus:Set(string.format("Visible eggs found: %d (showing up to %d).", #matches, EggMonitorMaxRows))
        for i = 1, EggMonitorMaxRows do
            local match = matches[i]
            if match then
                EggMonitorRows[i]:Set(string.format("🥚 %s — %d studs", match.Name, math.floor(match.Distance + 0.5)))
            else
                EggMonitorRows[i]:Set("")
            end
        end
    end,
})

