local rng = Random.new()

local function FloatEmoji(emoji, parent, x, size, duration)
    local label = New("TextLabel", parent, {
        Size = UDim2.fromOffset(size, size),
        Position = UDim2.new(x, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = emoji,
        TextSize = size,
        TextTransparency = 0.45,
        Rotation = rng:NextInteger(-25, 25),
        ZIndex = 11,
    })
    Play(label, duration, {
        Position = UDim2.new(x + rng:NextNumber(-0.12, 0.12), 0, -0.1, 0),
        TextTransparency = 1,
        Rotation = rng:NextInteger(-50, 50),
    }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut):Play()
    task.delay(duration + 0.1, function()
        if label then label:Destroy() end
    end)
end

local function Burst(origin, count)
    for _ = 1, count do
        local label = New("TextLabel", ScreenGui, {
            Size = UDim2.fromOffset(18, 18),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(origin.X, origin.Y),
            BackgroundTransparency = 1,
            Text = ICONS[rng:NextInteger(1, #ICONS)],
            TextSize = rng:NextInteger(14, 22),
            ZIndex = 60,
        })
        local angle = rng:NextNumber(0, math.pi * 2)
        local dist = rng:NextNumber(35, 80)
        Play(label, 0.7, {
            Position = UDim2.fromOffset(origin.X + math.cos(angle) * dist, origin.Y + math.sin(angle) * dist - 20),
            TextTransparency = 1,
            Rotation = rng:NextInteger(-90, 90),
        }):Play()
        task.delay(0.8, function()
            if label then label:Destroy() end
        end)
    end
end

local function Strike()
    Play(Flash, 0.05, {BackgroundTransparency = 0.7}):Play()
    task.delay(0.08, function()
        Play(Flash, 0.08, {BackgroundTransparency = 1}):Play()
        task.delay(0.12, function()
            Play(Flash, 0.05, {BackgroundTransparency = 0.8}):Play()
            task.delay(0.07, function()
                Play(Flash, 0.35, {BackgroundTransparency = 1}):Play()
            end)
        end)
    end)
end

