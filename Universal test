                corner(badge, 9)
                mkLabel(badge, {
                    Size = UDim2.new(1,0,1,0),
                    Text = "NEW",
                    TextColor3 = Color3.new(1,1,1),
                    Font = Enum.Font.GothamBold,
                    TextSize = 9,
                    ZIndex = 11,
                })
            else
                mkLabel(card, {
                    Size     = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    Text     = "›",
                    TextColor3 = C.muted,
                    Font     = Enum.Font.GothamBold,
                    TextSize = 20,
                    ZIndex   = 9,
