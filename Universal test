-- FPS TRACKER
-- ════════════════════════════════════════════════════════════
local fpsVal     = 60
local fpsCounter = 0
local fpsTimer   = 0
local fpsConn    = nil

local function startFPS(label)
    fpsConn = RunService.Heartbeat:Connect(function(dt)
        fpsCounter = fpsCounter + 1
        fpsTimer   = fpsTimer + dt
        if fpsTimer >= 0.5 then
            fpsVal    = math.round(fpsCounter / fpsTimer)
            fpsTimer  = 0
            fpsCounter= 0
            if label and label.Parent then
                label.Text = "FPS " .. fpsVal
                label.TextColor3 = fpsVal >= 55 and C.green or (fpsVal >= 30 and C.yellow or C.red)
            end
        end
    end)
end

