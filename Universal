local function playSound(name)
    if not Settings2.sounds then return end
    pcall(function() if Sounds[name] then Sounds[name]:Play() end end)
end

local function tween(object, duration, properties, style, direction)
    local time = Settings2.reduceMotion and math.min(duration, 0.12) or duration
    local info = TweenInfo.new(time, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out)
    local item = TweenService:Create(object, info, properties)
    item:Play()
    return item
end

local function spring(object, duration, properties)
    return tween(object, duration, properties, Enum.EasingStyle.Back)
end

