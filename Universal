    mkLabel(row, {
        Size     = UDim2.new(1, -70, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        Text     = label,
        TextColor3 = C.white,
        Font     = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex   = 63,
    })

    mkLabel(row, {
        Size     = UDim2.new(1, -70, 0, 16),
        Position = UDim2.new(0, 12, 0, 30),
        Text     = desc,
        TextColor3 = C.muted,
        Font     = Enum.Font.Gotham,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex   = 63,
    })

    -- Toggle switch track
    local track = mkFrame(row, {
        Size     = UDim2.new(0, 44, 0, 24),
        Position = UDim2.new(1, -56, 0.5, -12),
        BackgroundColor3 = Settings[key] and C.royal or C.divider,
        ZIndex   = 63,
    })
    corner(track, 12)

    -- Toggle switch knob
    local knob = mkFrame(track, {
        Size     = UDim2.new(0, 18, 0, 18),
        Position = Settings[key] and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Color3.new(1,1,1),
        ZIndex   = 64,
    })
    corner(knob, 9)

    local function updateToggle()
        local on = Settings[key]
        tw(track, 0.2, nil, nil, {BackgroundColor3 = on and C.royal or C.divider})
        tw(knob, 0.2, Enum.EasingStyle.Back, nil,
           {Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)})
    end

    settingToggleFns[key] = updateToggle

    local btn = mkBtn(row, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 65,
    })
    btn.MouseButton1Click:Connect(function()
        play("tap")
        Settings[key] = not Settings[key]
        updateToggle()
    end)

    return row
end

