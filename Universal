-- ║  INSTANCE FACTORY                                                        ║
-- ╚══════════════════════════════════════════════════════════════════════════╝
local GlowTargets = {}

local function set(obj, props)
    for k, v in pairs(props or {}) do obj[k] = v end
    return obj
end

local function new(cls, parent)
    local o = Instance.new(cls)
    o.Parent = parent
    return o
end

local function frm(parent, props)
    local f = new("Frame", parent)
    f.BorderSizePixel = 0
    return set(f, props)
end

local function lbl(parent, props)
    local l = new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.TextWrapped = false
    set(l, props)
    if Cfg.glowFX then table.insert(GlowTargets, l) end
    return l
end

local function btn(parent, props)
    local b = new("TextButton", parent)
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    set(b, props)
    if Cfg.glowFX then table.insert(GlowTargets, b) end
    return b
end

local function img(parent, props)
    local i = new("ImageLabel", parent)
    i.BackgroundTransparency = 1
    return set(i, props)
end

local function scroll(parent, props)
    local s = new("ScrollingFrame", parent)
    s.BorderSizePixel      = 0
    s.BackgroundTransparency = 1
    s.ScrollBarThickness   = 3
    s.ScrollBarImageColor3 = C.royal
    s.BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
    s.TopImage    = "rbxasset://textures/ui/Scroll/scroll-middle.png"
    s.MidImage    = "rbxasset://textures/ui/Scroll/scroll-middle.png"
    return set(s, props)
end

local function corner(p, r)
    return set(new("UICorner", p), { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(p, col, th, tr)
    return set(new("UIStroke", p), {
        Color = col or C.line, Thickness = th or 1.2,
        Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function grad(p, c0, c1, rot)
    return set(new("UIGradient", p), {
        Color = ColorSequence.new(c0, c1), Rotation = rot or 90,
    })
end

local function list(p, props)
    local l = new("UIListLayout", p)
    return set(l, props or {})
end

local function grid(p, props)
    local g = new("UIGridLayout", p)
    return set(g, props or {})
end

local function pad(p, l, r, t, b)
    return set(new("UIPadding", p), {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    })
end

local GLOW_ID = "rbxassetid://5028857084"

local function glowImg(parent, size, col, trans, pos)
    return img(parent, {
        Image             = GLOW_ID,
        ImageColor3       = col or C.royal,
        ImageTransparency = trans or 0.70,
        Size              = UDim2.fromOffset(size, size),
        Position          = pos or UDim2.new(0.5, -size/2, 0.5, -size/2),
        ZIndex            = (parent.ZIndex or 1),
    })
end

-- Hover/press wire for any button
local function wire(b, base, hov, ac)
    b.MouseEnter:Connect(function()
        tw(b, 0.14, { BackgroundColor3 = hov or C.cardHov })
    end)
    b.MouseLeave:Connect(function()
        tw(b, 0.16, { BackgroundColor3 = base or C.card })
    end)
    b.MouseButton1Down:Connect(function()
        spring(b, 0.10, {
            Size     = UDim2.new(b.Size.X.Scale, b.Size.X.Offset - 3,
                                  b.Size.Y.Scale, b.Size.Y.Offset - 2),
            Position = UDim2.new(b.Position.X.Scale, b.Position.X.Offset + 1,
                                  b.Position.Y.Scale, b.Position.Y.Offset + 1),
        })
    end)
    b.MouseButton1Up:Connect(function()
        spring(b, 0.14, {
            Size     = UDim2.new(b.Size.X.Scale, b.Size.X.Offset + 3,
                                  b.Size.Y.Scale, b.Size.Y.Offset + 2),
            Position = UDim2.new(b.Position.X.Scale, b.Position.X.Offset - 1,
                                  b.Position.Y.Scale, b.Position.Y.Offset - 1),
        })
    end)
end

local function setClip(text)
    pcall(function() if setclipboard then setclipboard(text) end end)
end

