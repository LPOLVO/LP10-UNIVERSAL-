local function buildLibrary(page)
    local names = {Scripts = "Script library", Favorites = "Favorites", Pinned = "Pinned scripts", Recent = "Recently executed"}
    PageTitle.Text = names[page] or "Script library"
    PageSub.Text   = page == "Scripts" and "Pick a script to inspect it before execution." or "Your curated LP10 collection."
    local list  = listForPage(page)
    local query = string.lower(SearchBox.Text or "")
    local visible = 0
    for _, data in ipairs(list) do
        if query == "" or string.find(string.lower(data.N), query, 1, true) then
            visible = visible + 1
            card(Body, data, visible)
        end
    end
    if visible == 0 then
        label(Body, {
            Size           = UDim2.new(1, 0, 0, 100),
            Text           = query ~= "" and ("No matches for \"" .. SearchBox.Text .. "\"") or "Nothing here yet.\nOpen a script to start building this collection.",
