    if settingsOpen then
        settingsOpen = false
        tw(SettingsPanel, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In, {Position = SET_HIDE})
    end

    play("close")
    tw(Main, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In,
       {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
