local function makeToggle(parent, title, desc, key, order)
    local row = frame(parent, {
        Size=UDim2.new(1,0,0,62),
        BackgroundColor3=C.card, LayoutOrder=order, ZIndex=16,
    })
    round(row, 13)
    outline(row, C.line, 1)
    label(row, {Size=UDim2.new(1,-82,0,20), Position=UDim2.fromOffset(14,9),  Text=title, TextColor3=C.white, Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=17})
    label(row, {Size=UDim2.new(1,-82,0,16), Position=UDim2.fromOffset(14,31), Text=desc,  TextColor3=C.muted, Font=Enum.Font.Gotham,     TextSize=9,  TextXAlignment=Enum.TextXAlignment.Left, ZIndex=17})
    local track = frame(row, {Size=UDim2.fromOffset(46,24), Position=UDim2.new(1,-60,0.5,-12), BackgroundColor3=Settings[key] and C.royal or C.line, ZIndex=17})
    round(track, 12)
    local knob = frame(track, {Size=UDim2.fromOffset(18,18), Position=Settings[key] and UDim2.new(1,-21,0.5,-9) or UDim2.fromOffset(3,3), BackgroundColor3=C.white, ZIndex=18})
    round(knob, 9)
    local hit = button(row, {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", ZIndex=19})
    hit.MouseButton1Click:Connect(function()
        play("tap")
        Settings[key] = not Settings[key]
        tw(track, 0.2, {BackgroundColor3=Settings[key] and C.royal or C.line})
        spring(knob, 0.25, {Position=Settings[key] and UDim2.new(1,-21,0.5,-9) or UDim2.fromOffset(3,3)})
        if key == "performance" or key == "reduceMotion" then
            Settings.particles = not Settings.performance and not Settings.reduceMotion
        end
    end)
end

