-- ║  RESPONSIVE LAYOUT                                                       ║
-- ╚══════════════════════════════════════════════════════════════════════════╝
local function applyLayout()
    local vp     = Cam.ViewportSize
    local narrow = vp.X < 640

    Side.Visible        = not narrow
    Content.Position    = narrow and UDim2.fromOffset(0,64) or UDim2.fromOffset(SIDE_W,64)
    Content.Size        = narrow and UDim2.new(1,0,1,-64) or UDim2.new(1,-SIDE_W,1,-64)
    HdrTitle.Visible    = not narrow
    HdrSub.Visible      = not narrow
    HdrStats.Visible    = vp.X > 720
    HdrClock.Visible    = vp.X > 720
    Detail.Size         = narrow
        and UDim2.fromScale(1,1)
        or  UDim2.new(1,-SIDE_W,1,-64)
    Detail.Position     = DetailOpen
        and (narrow and UDim2.fromOffset(0,64) or UDim2.fromOffset(SIDE_W,64))
        or  UDim2.new(1,20,0,64)
end

Cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)

