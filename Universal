-- HAPTIC FEEDBACK HELPER  (mobile rumble on execute)
-- ════════════════════════════════════════════════════════════════════════════
local HapticService = nil
pcall(function() HapticService = game:GetService("HapticService") end)

local function haptic(intensity)
    pcall(function()
        if HapticService and UIS.TouchEnabled then
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Large, intensity or 0.4)
            task.delay(0.12, function()
                pcall(function()
                    HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Large, 0)
                end)
            end)
        end
    end)
end

-- Trigger haptic on execute
local _origExecFinal = execScript
execScript = function(data)
    haptic(0.55)
    _origExecFinal(data)
end

-- ════════════════════════════════════════════════════════════════════════════
-- QUICK-EXEC SWIPE  (swipe right on a script card to execute immediately)
-- ════════════════════════════════════════════════════════════════════════════
-- Stored per-card data for swipe detection
local swipeData = {}

local function enableSwipeExec(item, data)
    local startX, startY, swiping = 0, 0, false
    item.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch then
            startX, startY, swiping = inp.Position.X, inp.Position.Y, true
        end
    end)
    item.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch and swiping then
            swiping = false
            local dx = inp.Position.X - startX
            local dy = math.abs(inp.Position.Y - startY)
            if dx > 80 and dy < 40 then
                -- Right swipe detected — quick execute
                execScript(data)
                toast("Swiped!", "Executing "..data.N.."…", C.electric)
                spring(item, 0.18, {Position=UDim2.new(item.Position.X.Scale, 40, item.Position.Y.Scale, item.Position.Y.Offset)})
                task.delay(0.2, function()
                    tw(item, 0.14, {Position=UDim2.new(item.Position.X.Scale, 0, item.Position.Y.Scale, item.Position.Y.Offset)})
                end)
            end
        end
    end)
end

-- Extend scriptCard for swipe support
local _origCardFinal = scriptCard
scriptCard = function(parent, data, order)
    local item = _origCardFinal(parent, data, order)
    if item and UIS.TouchEnabled then
        enableSwipeExec(item, data)
    end
    return item
end

