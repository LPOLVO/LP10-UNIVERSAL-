local electricPhase = 0
local electricAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
    electricPhase = electricPhase + dt * (Settings.reduceMotion and 1.4 or 3.8)
    electricAccumulator = electricAccumulator + dt
    if electricAccumulator < (Settings.performance and 0.14 or 0.07) then return end
    electricAccumulator = 0
    local pulse = 0.42 + ((math.sin(electricPhase) + 1) * 0.5) * 0.28
    for index = #ElectricTextTargets, 1, -1 do
        local target = ElectricTextTargets[index]
        if target and target.Parent then
            target.TextStrokeColor3 = Settings.glow and C.electric or target.TextColor3
            target.TextStrokeTransparency = Settings.glow and pulse or 1
        else
            table.remove(ElectricTextTargets, index)
        end
    end
end)

local function openMain()
    applySize(WIN_W, WIN_H, false)
    Main.Visible = true
    Main.Size = UDim2.fromScale(0.94, 0.94)
    Main.Position = UDim2.fromScale(0.03, 0.03)
    if Settings.blur then Blur.Enabled = true; tween(Blur, 0.4, {Size = 12}) end
    play("open")
    spring(Main, 0.5, {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0)})
    LaunchCurtain.Visible = true
    LaunchCurtain.BackgroundTransparency = 0
    LaunchCore.BackgroundTransparency = 0
    LaunchFill.Size = UDim2.new(0, 0, 1, 0)
    LaunchStatus.Text = "CONNECTING TO AURORA SHELL"
    task.spawn(function()
        tween(LaunchFill, 0.72, {Size = UDim2.fromScale(0.72, 1)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.wait(0.7)
        LaunchStatus.Text = "LOADING " .. SCRIPT_COUNT .. " SCRIPTS"
        tween(LaunchFill, 0.52, {Size = UDim2.fromScale(1, 1)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.wait(0.58)
        LaunchStatus.Text = "AURORA ONLINE"
        task.wait(0.32)
        tween(LaunchCore, 0.22, {BackgroundTransparency = 1})
        tween(LaunchGlow, 0.28, {ImageTransparency = 1})
        tween(LaunchCurtain, 0.34, {BackgroundTransparency = 1})
        task.wait(0.36)
        if LaunchCurtain and LaunchCurtain.Parent then LaunchCurtain.Visible = false end
    end)
end

