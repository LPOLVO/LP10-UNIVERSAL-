local function listForPage(page)
    local result = {}
    if page == "Favorites" then
        for _, name in ipairs(Persist.favorites) do
            for _, data in ipairs(Scripts) do if data.N == name then table.insert(result, data) end end
        end
    elseif page == "Pinned" then
        for _, name in ipairs(Persist.pinned) do
            for _, data in ipairs(Scripts) do if data.N == name then table.insert(result, data) end end
        end
    elseif page == "Recent" then
        for _, name in ipairs(Persist.recent) do
            for _, data in ipairs(Scripts) do if data.N == name then table.insert(result, data) end end
        end
    else
        for _, data in ipairs(Scripts) do table.insert(result, data) end
    end
    return result
end

