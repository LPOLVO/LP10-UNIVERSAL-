-- ║  LIST HELPERS                                                            ║
-- ╚══════════════════════════════════════════════════════════════════════════╝
local CurrentPage = Persist.page or "Home"
local CurrentCat  = "All"

local function flip(t, v)
    for i, x in ipairs(t) do
        if x == v then table.remove(t, i); return false end
    end
    table.insert(t, 1, v)
    return true
end

local function has(t, v)
    for _, x in ipairs(t) do if x == v then return true end end
    return false
end

local function scriptIcon(data)
    local icons = {
        Combat   = "⚔",
        Movement = "↑",
        Teleport = "⊛",
        Utility  = "⚙",
        Visual   = "◉",
    }
    return icons[data.Cat] or "▶"
end

local function executeScript(data)
    if not data then return end
    play("exec")
    log(data.N)

    -- Insert into recent
    for i, v in ipairs(Persist.recent) do
        if v == data.N then table.remove(Persist.recent, i); break end
    end
    table.insert(Persist.recent, 1, data.N)
    if #Persist.recent > 10 then
        table.remove(Persist.recent, #Persist.recent)
    end

    toast("Executing", data.N, C.green)

    -- Glow flash on execute button
    tw(DetailExec, 0.10, { BackgroundColor3=C.green })
    task.wait(0.16)
    tw(DetailExec, 0.22, { BackgroundColor3=C.electric })
    task.wait(0.5)

    closeDetail()
    task.wait(0.32)

    -- Close UI and execute
    tw(Main, 0.34, {
        Size    =UDim2.fromScale(0,0),
        Position=UDim2.fromScale(0.5,0.5),
    }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tw(Blur, 0.34, {Size=0}, nil, Enum.EasingDirection.In)
    task.wait(0.38)
    pcall(function() Blur.Enabled=false; GUI:Destroy() end)
    loadstring(data.S)()
end

