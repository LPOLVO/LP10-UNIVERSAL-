    playSound("open")
    spring(Main, 0.5, {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0)})

    LaunchCurtain.Visible = true
    LaunchCurtain.BackgroundTransparency = 0
    LaunchCore.BackgroundTransparency   = 0
    LaunchFill.Size = UDim2.new(0, 0, 1, 0)
    LaunchStatus.Text = "CONNECTING TO AURORA SHELL"

    task.spawn(function()
        tween(LaunchFill, 0.72, {Size = UDim2.fromScale(0.72, 1)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.wait(0.7)
        LaunchStatus.Text = "LOADING " .. SCRIPT_COUNT .. " SCRIPTS"
        tween(LaunchFill, 0.52, {Size = UDim2.fromScale(1, 1)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.wait(0.58)
        LaunchStatus.Text = "AURORA ONLINE"
        task.wait(0.32)
        tween(LaunchCore,    0.22, {BackgroundTransparency = 1})
        tween(LaunchGlow,    0.28, {ImageTransparency      = 1})
        tween(LaunchCurtain, 0.34, {BackgroundTransparency = 1})
        task.wait(0.36)
        if LaunchCurtain and LaunchCurtain.Parent then LaunchCurtain.Visible = false end
    end)
end

