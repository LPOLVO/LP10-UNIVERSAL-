-- SCRIPT EXECUTION ENGINE
-- ════════════════════════════════════════════════════════════════════════════
local CurrentScript = nil

local function execScript(data)
    if not data then return end
    play("exec")
    log(data.N)
    addRecent(data.N)
    Persist.execCount = (Persist.execCount or 0) + 1
    Persist.totalExecs[data.N] = (Persist.totalExecs[data.N] or 0) + 1
    -- Update recent games
    if GAME_NAME ~= "Unknown Experience" then
        local found = false
        for i, g in ipairs(Persist.recentGames) do
            if g == GAME_NAME then found = true; table.remove(Persist.recentGames, i); break end
        end
        if not found and #Persist.recentGames >= 10 then
            table.remove(Persist.recentGames, #Persist.recentGames)
        end
        table.insert(Persist.recentGames, 1, GAME_NAME)
    end

    toast("Executing", data.N, C.electric)

    task.spawn(function()
        local ok, err = pcall(function()
            local fn = loadstring(data.S)
            if fn then
                fn()
            else
                -- Direct execution fallback
                pcall(function()
                    if type(data.S) == "string" then
                        local f, e = load(data.S)
                        if f then f() else error(e) end
                    end
                end)
            end
        end)
        if ok then
            task.delay(0.6, function()
                toast("Done", data.N.." executed successfully.", C.green)
            end)
        else
            toast("Failed", tostring(err):sub(1,80), C.red)
        end
    end)
end

local function closeDetail()
    play("slide")
    Detail.Visible = true
    tw(Detail, 0.28, {Position=UDim2.new(1,20,0,62)}, nil, Enum.EasingDirection.In)
    task.delay(0.3, function()
        if Detail then Detail.Visible = false end
    end)
end

local function openDetail(data)
    if not data then return end
    CurrentScript = data
    DetailTitle.Text = data.N
    DetailMeta.Text  = (data.Cat or "Universal"):upper().."   /   "..(data.New and "★ NEW" or "READY").."   /   DELTA COMPATIBLE"
    DetailDesc.Text  = data.F or "Script for "..data.N..". Delta compatible. Works on mobile and PC."
    DetailNewBadge.Visible = data.New == true
    local execd = Persist.totalExecs[data.N] or 0
    DetailExecCount.Text = execd > 0 and ("You've run this "..execd.." time".. (execd>1 and "s" or "")) or "Never executed yet"
    DetailFav.Text = has(Persist.favorites, data.N) and "★  FAVORITED" or "★  FAVORITE"
    DetailFav.TextColor3 = has(Persist.favorites, data.N) and C.yellow or C.muted
    DetailPin.Text = has(Persist.pinned, data.N) and "◆  PINNED" or "◆  PIN"
    DetailPin.TextColor3 = has(Persist.pinned, data.N) and C.ice or C.muted
    -- icon initials
    local words = {}
    for w in data.N:gmatch("%S+") do table.insert(words, w) end
    DetailIconLbl.Text = words[1] and string.sub(words[1],1,1):upper() or "▶"

    play("slide")
    Detail.Visible = true
    Detail.Position = UDim2.new(1,20,0,62)
