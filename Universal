-- BUTTON INTERACTION WIRING
-- ════════════════════════════════════════════════════════════════════════════
local function wire(item, base, hover)
    item.MouseEnter:Connect(function()
        tw(item, 0.14, {BackgroundColor3 = hover or C.cardHot})
    end)
    item.MouseLeave:Connect(function()
        tw(item, 0.14, {BackgroundColor3 = base})
    end)
    item.MouseButton1Down:Connect(function()
        spring(item, 0.1, {Size = UDim2.new(
            item.Size.X.Scale, item.Size.X.Offset - 3,
            item.Size.Y.Scale, item.Size.Y.Offset - 2)})
    end)
    item.MouseButton1Up:Connect(function()
        spring(item, 0.16, {Size = UDim2.new(
            item.Size.X.Scale, item.Size.X.Offset + 3,
            item.Size.Y.Scale, item.Size.Y.Offset + 2)})
    end)
end

-- ════════════════════════════════════════════════════════════════════════════
-- LIST HELPERS
-- ════════════════════════════════════════════════════════════════════════════
local function has(tbl, val)
    for _, v in ipairs(tbl) do if v == val then return true end end
    return false
end

local function flip(tbl, val)
    for i, v in ipairs(tbl) do
        if v == val then table.remove(tbl, i); return false end
    end
    table.insert(tbl, 1, val)
    return true
end

local function addRecent(name)
    for i, v in ipairs(Persist.recent) do
        if v == name then table.remove(Persist.recent, i); break end
    end
    table.insert(Persist.recent, 1, name)
    if #Persist.recent > 12 then
        table.remove(Persist.recent, #Persist.recent)
    end
end

