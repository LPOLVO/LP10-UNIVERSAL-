local function mkSnd(id, vol, pitch)
    local ok, s = pcall(function()
        local n = Instance.new("Sound")
        n.SoundId = "rbxassetid://" .. id
        n.Volume  = vol or 0.4
        n.PlaybackSpeed = pitch or 1
        n.Parent  = SoundService
        return n
    end)
    return ok and s or nil
end

