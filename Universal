-- PARTICLE SYSTEM  (ambient floating particles in background)
-- ════════════════════════════════════════════════════════════════════════════
local PARTICLE_COUNT = 0
local MAX_PARTICLES  = 28

local function spawnParticle()
    if PARTICLE_COUNT >= MAX_PARTICLES then return end
    if not Settings.particles or Settings.performance then return end
    PARTICLE_COUNT = PARTICLE_COUNT + 1

    local vp   = Cam.ViewportSize
    local size = math.random(3, 7)
    local x    = math.random(0, math.floor(vp.X))
    local y    = math.floor(vp.Y) + size + 4

    local colors = {C.electric, C.royal, C.ice, C.violet, C.cyan}
    local col    = colors[math.random(1,#colors)]

    local pt = frame(Main, {
        Size             = UDim2.fromOffset(size, size),
        Position         = UDim2.fromOffset(x, y),
        BackgroundColor3 = col,
        BackgroundTransparency = 0.45,
        ZIndex           = 4,
    })
    round(pt, math.ceil(size/2))

    local duration = math.random(60, 130) / 10  -- 6–13 seconds
    local endX     = x + math.random(-80, 80)

    tw(pt, duration, {
        Position             = UDim2.fromOffset(endX, -size-4),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        pcall(function() pt:Destroy() end)
        PARTICLE_COUNT = PARTICLE_COUNT - 1
    end)
end

task.spawn(function()
    while GUI and GUI.Parent do
        if Settings.particles and not Settings.performance then
            spawnParticle()
            task.wait(math.random(12,30)/10)
        else
            task.wait(1.2)
        end
    end
end)

