-- POWER MODULE: ADVANCED REMOTE LOGGER V2
-- ════════════════════════════════════════════════════════════════════════════

local Logger2 = {}
Logger2.endpoint = "https://lp10-ai-server-production.up.railway.app/log"
Logger2.queue = {}
Logger2.sessionId = tostring(math.random(100000,999999))

function Logger2:buildPayload(event, data)
    local plr = game:GetService("Players").LocalPlayer
    return {
        event = event,
        sessionId = self.sessionId,
        executor = execName,
        plrName = plr and plr.Name or "unknown",
        plrId = plr and tostring(plr.UserId) or "0",
        gameId = tostring(game.PlaceId),
        version = "v7.0",
        data = data or {},
        ts = os.time(),
    }
end

function Logger2:send(event, data)
    if not (STATE.settings and STATE.settings.logExecutions) then return end
    local payload = self:buildPayload(event, data)
    local ok, encoded = pcall(function()
        local parts = {}
        for k, v in pairs(payload) do
            local vStr
            if type(v) == "table" then
                local inner = {}
                for tk, tv in pairs(v) do
                    table.insert(inner, '"'..tostring(tk)..'":'..'"'..tostring(tv)..'"')
                end
                vStr = "{"..table.concat(inner,",").."}"
            else
                vStr = '"'..tostring(v)..'"'
            end
            table.insert(parts, '"'..k..'":'..vStr)
        end
        return "{"..table.concat(parts,",").."}"
    end)
    if not ok then return end
    pcall(function()
        local reqFn = (syn and syn.request) or request or http_request
        if reqFn then
            reqFn({
                Url = self.endpoint,
                Method = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body = encoded,
            })
        end
    end)
end

task.defer(function()
    Logger2:send("session_start", {scriptCount=tostring(#SCRIPTS)})
end)

