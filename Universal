-- POWER MODULE: SCRIPT SEARCH ENGINE v2
-- ════════════════════════════════════════════════════════════════════════════

local SearchEngine = {}
SearchEngine.query = ""
SearchEngine.activeCategory = "All"
SearchEngine.sortMode = "Default"
SearchEngine.history = {}

function SearchEngine:tokenize(str)
    local tokens = {}
    for word in string.lower(str):gmatch("%S+") do
        table.insert(tokens, word)
    end
    return tokens
end

function SearchEngine:score(script, query)
    if query == "" then return 100 end
    local q = string.lower(query)
    local title = string.lower(script.title or "")
    local desc = string.lower(script.desc or "")
    local tags = string.lower(table.concat(script.tags or {}, " "))
    local score = 0
    if title == q then score = score + 200
    elseif title:find(q, 1, true) then score = score + 100
    elseif title:sub(1, #q) == q then score = score + 80 end
    if desc:find(q, 1, true) then score = score + 30 end
    if tags:find(q, 1, true) then score = score + 60 end
    local tokens = self:tokenize(query)
    for _, tok in ipairs(tokens) do
        if title:find(tok, 1, true) then score = score + 20 end
        if desc:find(tok, 1, true) then score = score + 10 end
    end
    return score
end

function SearchEngine:filter(scripts)
    local results = {}
    for _, s in ipairs(scripts) do
        local catMatch = (self.activeCategory == "All") or (s.cat == self.activeCategory)
        local score = self:score(s, self.query)
        if catMatch and (self.query == "" or score > 0) then
            table.insert(results, {script=s, score=score})
        end
    end
    if self.sortMode == "A-Z" then
        table.sort(results, function(a,b) return a.script.title < b.script.title end)
    elseif self.sortMode == "Z-A" then
        table.sort(results, function(a,b) return a.script.title > b.script.title end)
    elseif self.sortMode == "MostUsed" then
        table.sort(results, function(a,b)
            local ea = (STATE.execCounts[a.script.title] or 0)
            local eb = (STATE.execCounts[b.script.title] or 0)
            return ea > eb
        end)
    else
        table.sort(results, function(a,b) return a.score > b.score end)
    end
    local out = {}
    for _, r in ipairs(results) do table.insert(out, r.script) end
    return out
end

function SearchEngine:addHistory(query)
    if query == "" then return end
    for i=#self.history,1,-1 do
        if self.history[i] == query then table.remove(self.history, i) end
    end
    table.insert(self.history, 1, query)
    if #self.history > 20 then table.remove(self.history, #self.history) end
end

function SearchEngine:getSuggestions(partial)
    if partial == "" then return {} end
    local p = string.lower(partial)
    local seen = {}
    local out = {}
    for _, s in ipairs(SCRIPTS) do
        local t = string.lower(s.title)
        if t:find(p, 1, true) and not seen[s.title] then
            seen[s.title] = true
            table.insert(out, s.title)
        end
    end
    for _, h in ipairs(self.history) do
        if string.lower(h):find(p, 1, true) and not seen[h] then
            seen[h] = true
            table.insert(out, h)
        end
    end
    local limited = {}
    for i=1, math.min(8, #out) do limited[i] = out[i] end
    return limited
end

