local function updateNavState()
    for id, data in pairs(NavBtns) do
        local active = id == CurrentPage
        tw(data.btn, 0.18, {
            BackgroundColor3 = active and Color3.fromRGB(20,40,100) or C.sidebar,
        })
        tw(data.bar, 0.18, {
            BackgroundTransparency = active and 0 or 1,
        })
        for _, ch in ipairs(data.btn:GetChildren()) do
            if ch:IsA("TextLabel") then
                tw(ch, 0.18, {
                    TextColor3 = active and (ch.Position.X.Offset < 30 and C.electric or C.white)
                                         or (ch.Position.X.Offset < 30 and C.muted or C.text),
                })
            end
        end
    end
end

local function updateCatState()
    for id, cb in pairs(CatBtns) do
        local active = id == CurrentCat
        tw(cb, 0.16, {
            BackgroundColor3 = active and C.royal or C.card,
        })
        for _, st in ipairs(cb:GetChildren()) do
            if st:IsA("UIStroke") then
                tw(st, 0.16, { Color = active and C.royalBri or C.line })
            end
        end
        cb.TextColor3 = active and C.white or C.muted
    end
end

refresh = function()
    wipe()
    Body.CanvasPosition = Vector2.new(0,0)
    if     CurrentPage == "Home"      then buildHome()
    elseif CurrentPage == "Games"     then buildGames()
    elseif CurrentPage == "Changelog" then buildChangelog()
    elseif CurrentPage == "Settings"  then buildSettings()
    elseif CurrentPage == "About"     then buildAbout()
    else   buildLibrary(CurrentPage) end
    updateNavState()
    updateCatState()
end

changePage = function(id)
    if id == CurrentPage and id ~= "Home" then return end
    CurrentPage    = id
    Persist.page   = id
    SearchBox.Text = ""
    SearchClear.Visible = false
    play("slide")
    refresh()
end

