-- TOOLTIP OVERLAY  (shows on long-press / right-click on script cards)
-- ════════════════════════════════════════════════════════════════════════════
local function showTooltip(data, anchorX, anchorY)
    local meta  = ScriptMeta[data.N] or {}
    local tipText = meta.tips or "Delta compatible. Works on mobile and PC."
    local risk  = meta.risk or "LOW"
    local riskCol = risk == "HIGH" and C.red or (risk == "MEDIUM" and C.yellow or C.green)

    local tip = frame(GUI, {
        Size             = UDim2.fromOffset(268, 110),
        Position         = UDim2.fromOffset(math.min(anchorX+10, Cam.ViewportSize.X-280), math.max(anchorY-56, 10)),
        BackgroundColor3 = C.panel,
        ZIndex           = 150,
    })
    round(tip, 14)
    outline(tip, C.line, 1)
    fillGradient(tip, Color3.fromRGB(16,24,54), C.panel, 135)

    label(tip, {
        Size=UDim2.new(1,-32,0,18), Position=UDim2.fromOffset(12,8),
        Text=data.N, TextColor3=C.white, Font=Enum.Font.GothamBold, TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=151,
        TextTruncate=Enum.TextTruncate.AtEnd,
    })
    label(tip, {
        Size=UDim2.new(1,-24,0,44), Position=UDim2.fromOffset(12,28),
        Text=tipText, TextColor3=C.text, Font=Enum.Font.Gotham, TextSize=10,
        TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=151,
    })
    local riskBadge = frame(tip, {
        Size=UDim2.fromOffset(58,18), Position=UDim2.fromOffset(12,78),
        BackgroundColor3=Color3.fromRGB(8,12,26), ZIndex=151,
    })
    round(riskBadge, 7)
    outline(riskBadge, riskCol, 1)
    label(riskBadge, {
        Size=UDim2.fromScale(1,1), Text="RISK: "..risk,
        TextColor3=riskCol, Font=Enum.Font.GothamBold, TextSize=8, ZIndex=152,
    })
    local testedLbl = label(tip, {
        Size=UDim2.new(1,-80,0,18), Position=UDim2.fromOffset(80,78),
        Text="TESTED: "..(meta.tested or "Delta 1.2"),
        TextColor3=C.muted, Font=Enum.Font.Gotham, TextSize=8,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=151,
    })

    spring(tip, 0.22, {Size=UDim2.fromOffset(272,114)})
    task.delay(3.5, function()
        if tip and tip.Parent then
            tw(tip, 0.2, {BackgroundTransparency=1})
            task.wait(0.22)
            pcall(function() tip:Destroy() end)
        end
    end)
    return tip
end

