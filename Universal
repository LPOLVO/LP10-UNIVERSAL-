-- TOAST NOTIFICATION SYSTEM
-- ════════════════════════════════════════════════════════════════════════════
local toastQueue = {}
local toastActive = false

local function showNextToast()
    if #toastQueue == 0 then toastActive = false; return end
    toastActive = true
    local data = table.remove(toastQueue, 1)
    local card = frame(GUI, {
        Size             = UDim2.fromOffset(320, 76),
        Position         = UDim2.new(1, 20, 1, -100),
        BackgroundColor3 = C.panel,
        ZIndex           = 120,
    })
    round(card, 16)
    outline(card, data.col or C.electric, 1.2)
    fillGradient(card, Color3.fromRGB(18, 28, 62), C.surface, 135)
    -- color bar
    frame(card, {
        Size             = UDim2.new(0, 3, 1, -22),
        Position         = UDim2.fromOffset(10, 11),
        BackgroundColor3 = data.col or C.electric,
        ZIndex           = 121,
    })
    glow(card, 80, data.col or C.electric, 0.82, UDim2.fromOffset(-10, -10))
    label(card, {
        Size           = UDim2.new(1, -42, 0, 22),
        Position       = UDim2.fromOffset(28, 12),
        Text           = data.title,
        TextColor3     = C.white,
        Font           = Enum.Font.GothamBold,
        TextSize       = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 121,
    })
    label(card, {
        Size           = UDim2.new(1, -42, 0, 26),
        Position       = UDim2.fromOffset(28, 36),
        Text           = data.msg,
        TextColor3     = C.text,
        Font           = Enum.Font.Gotham,
        TextSize       = 11,
        TextWrapped    = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 121,
    })
    play("notif")
    tw(card, 0.36, {Position = UDim2.new(1, -338, 1, -100)})
    task.delay(3.4, function()
        if card and card.Parent then
            tw(card, 0.28, {Position = UDim2.new(1, 20, 1, -100)}, nil, Enum.EasingDirection.In)
            task.wait(0.32)
            pcall(function() card:Destroy() end)
        end
        task.wait(0.12)
        showNextToast()
    end)
end

local function toast(title, msg, col)
    table.insert(toastQueue, {title=title, msg=msg, col=col})
    if not toastActive then showNextToast() end
end

