local PARTICLE_COUNT = 0
local MAX_PARTICLES  = 22
local SPIRITS = {"🦇","👻","🎃","🕸️","🕷️","🍬","💀"}

local function spawnParticle()
    if PARTICLE_COUNT >= MAX_PARTICLES then return end
    if not Settings.particles or Settings.performance then return end
    PARTICLE_COUNT = PARTICLE_COUNT + 1

    local size = math.random(14, 26)
    local x    = math.random(5, 95) / 100
    local pt = new("TextLabel", AuroraFX, {
        Size                   = UDim2.fromOffset(size + 6, size + 6),
        Position               = UDim2.new(x, 0, 1, size),
        BackgroundTransparency = 1,
        Text                   = SPIRITS[math.random(1, #SPIRITS)],
        TextSize               = size,
        TextTransparency       = 0.35,
        Rotation               = math.random(-20, 20),
        ZIndex                 = 3,
    })
    local duration = math.random(70, 140) / 10
    tw(pt, duration, {
        Position         = UDim2.new(math.clamp(x + math.random(-12, 12) / 100, 0, 1), 0, -0.1, 0),
        TextTransparency = 1,
        Rotation         = math.random(-50, 50),
    }, Enum.EasingStyle.Linear)
    task.delay(duration, function()
        pcall(function() pt:Destroy() end)
        PARTICLE_COUNT = PARTICLE_COUNT - 1
    end)
end

task.spawn(function()
    while GUI and GUI.Parent do
        if Settings.particles and not Settings.performance then
            spawnParticle()
            task.wait(math.random(8, 20) / 10)
        else
            task.wait(1.2)
        end
    end
end)

