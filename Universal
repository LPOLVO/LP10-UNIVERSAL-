        local q = CmdInput.Text:lower()
        local found = nil
        for _, d in ipairs(Scripts) do
            if d.N:lower():find(q, 1, true) then found = d; break end
        end
        if found then
            closeCmd()
            task.delay(0.08, function() openDetail(found) end)
        else
            toast("Not Found", '"'..CmdInput.Text..'"'..": no matching script.", C.red)
        end
