-- ANIMATED LOADING DOTS  (shown in Body area while page renders)
-- ════════════════════════════════════════════════════════════════════════════
local function showLoading(parent)
    local dots = label(parent, {
        Size=UDim2.new(1,0,0,44), LayoutOrder=0,
        Text="Loading…",
        TextColor3=C.electric, Font=Enum.Font.GothamBold, TextSize=14,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=17,
    })
    task.spawn(function()
        local frames2 = {"Loading   ","Loading.  ","Loading.. ","Loading..."}
        local fi = 1
        while dots and dots.Parent do
            dots.Text = frames2[fi]
            fi = fi % #frames2 + 1
            task.wait(0.28)
        end
    end)
    return dots
end

