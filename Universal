local function updateNav()
    for id, btn in pairs(NavButtons) do
        local active = id == CurrentPage
        tw(btn, 0.14, {BackgroundColor3 = active and C.navActive or C.sidebar})
        btn.TextColor3 = active and C.white or C.text
    end
    AboutBtn.BackgroundColor3 = CurrentPage == "About" and C.navActive or C.sidebar
end

local function refresh()
    local lib = LIBRARY_PAGES[CurrentPage] == true
    CatStrip.Visible = lib
    Body.Position = UDim2.fromOffset(0, lib and 90 or 52)
    Body.Size     = UDim2.new(1, 0, 1, lib and -90 or -52)

    wipeBody()
    if     CurrentPage == "Home"      then buildHome()
    elseif CurrentPage == "Games"     then buildGames()
    elseif CurrentPage == "Changelog" then buildChangelog()
    elseif CurrentPage == "Settings"  then buildSettings()
    elseif CurrentPage == "About"     then buildAbout()
    elseif CurrentPage == "Stats"     then buildStats()
    elseif CurrentPage == "Notifs"    then buildNotifCenter()
    else                                   buildLibrary(CurrentPage)
    end
    updateNav()
end

local function changePage(id)
    CurrentPage = id
    Persist.page = id
    suppressSearch = true
    SearchBox.Text = ""
    suppressSearch = false
    SearchClear.Visible = false
    Body.CanvasPosition = Vector2.new(0,0)
    if Detail.Visible then
        Detail.Visible = false
        Detail.Position = UDim2.new(1,20,0,62)
    end
    if lastNarrow and sideOpen then
        sideOpen = false
        if applyLayout then applyLayout() end
    end
    play("slide")
    refresh()
end

