tabsList.FillDirection = Enum.FillDirection.Horizontal
tabsList.Padding = UDim.new(0, 6)
tabsList.SortOrder = Enum.SortOrder.LayoutOrder
tabsList.VerticalAlignment = Enum.VerticalAlignment.Center

local activeCat = "All"
local tabBtns   = {}

local function buildTabs()
    for _, cat in ipairs(CATEGORIES) do
        local isActive = (cat.id == activeCat)
        local tabW = #cat.label * 8 + 32

        local tab = mkBtn(tabsScroll, {
            Size     = UDim2.new(0, tabW, 0, TABS_H - 6),
            BackgroundColor3 = isActive and C.royal or C.card,
            Text     = cat.icon .. " " .. cat.label,
            TextColor3 = isActive and Color3.new(1,1,1) or C.muted,
            Font     = Enum.Font.GothamSemibold,
            TextSize = 11,
            LayoutOrder = _,
            ZIndex   = 11,
        })
        corner(tab, 10)
        if isActive then
            stroke(tab, C.electric, 1)
            gradient(tab, C.electric, C.royal, 135)
        else
            stroke(tab, C.divider, 1)
        end

        tabBtns[cat.id] = tab

        tab.MouseButton1Click:Connect(function()
            play("tap")
            activeCat = cat.id
            -- Rebuild tabs to show active state
            for _, child in ipairs(tabsScroll:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
            buildTabs()
            buildList()
        end)

        tab.MouseEnter:Connect(function()
            if activeCat ~= cat.id then
                tw(tab, 0.12, nil, nil, {BackgroundColor3 = C.cardHov})
            end
        end)
        tab.MouseLeave:Connect(function()
            if activeCat ~= cat.id then
                tw(tab, 0.12, nil, nil, {BackgroundColor3 = C.card})
            end
        end)
    end
end

