local function wireButton(item, base, hover)
    item.MouseEnter:Connect(function()
        tween(item, 0.14, {BackgroundColor3 = hover or C.cardHot})
    end)
    item.MouseLeave:Connect(function()
        tween(item, 0.14, {BackgroundColor3 = base})
    end)
    item.MouseButton1Down:Connect(function()
        spring(item, 0.1, {
            Size = UDim2.new(item.Size.X.Scale, item.Size.X.Offset - 4,
                             item.Size.Y.Scale, item.Size.Y.Offset - 3)
        })
    end)
    item.MouseButton1Up:Connect(function()
        spring(item, 0.16, {
            Size = UDim2.new(item.Size.X.Scale, item.Size.X.Offset + 4,
                             item.Size.Y.Scale, item.Size.Y.Offset + 3)
        })
    end)
end

