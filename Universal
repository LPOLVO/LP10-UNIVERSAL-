local CARD_H = 60

local function buildList()
    -- Clear existing cards
    for _, c in ipairs(Scroll:GetChildren()) do
        if c:IsA("TextButton") or (c:IsA("Frame") and c.Name:sub(1,4) == "card") then
            c:Destroy()
        end
    end

    local q   = SearchBox.Text:lower()
    local cat = activeCat
    local i   = 0

    for idx, d in ipairs(Scripts) do
        local matchSearch = d.N:lower():find(q, 1, true)
        local matchCat    = (cat == "All")
                         or (cat == "New" and d.New)
                         or (d.Cat == cat)

        if matchSearch and matchCat then
            i = i + 1

            local card = mkBtn(Scroll, {
                Name  = "card_" .. idx,
                Size  = UDim2.new(1, 0, 0, CARD_H),
                BackgroundColor3 = C.card,
                Text  = "",
                LayoutOrder = i,
                ZIndex = 8,
            })
            corner(card, 14)

            if d.New then
                stroke(card, C.red, 1.5)
            else
                stroke(card, C.divider, 1)
            end

            -- Left accent bar
            local bar = mkFrame(card, {
                Size     = UDim2.new(0, 3, 1, -18),
                Position = UDim2.new(0, 8, 0, 9),
                BackgroundColor3 = d.New and C.red or C.royal,
                ZIndex   = 9,
            })
            corner(bar, 3)

            -- Script icon background
            local iconBg = mkFrame(card, {
                Size     = UDim2.new(0, 36, 0, 36),
                Position = UDim2.new(0, 18, 0.5, -18),
                BackgroundColor3 = d.New and Color3.fromRGB(40, 10, 10) or C.navy,
                ZIndex   = 9,
            })
            corner(iconBg, 10)
            stroke(iconBg, d.New and C.red or C.divider, 1)

            mkLabel(iconBg, {
                Size = UDim2.new(1,0,1,0),
                Text = d.New and "★" or (d.Cat == "Combat" and "⚔" or d.Cat == "Movement" and "↑" or
                       d.Cat == "Teleport" and "⊛" or d.Cat == "Utility" and "⚙" or
                       d.Cat == "Visual" and "◉" or "◈"),
                TextColor3 = d.New and C.red or C.royal,
                Font = Enum.Font.GothamBold,
                TextSize = 16,
                ZIndex = 10,
            })

            -- Script name
            mkLabel(card, {
                Size     = UDim2.new(1, -100, 0, 22),
                Position = UDim2.new(0, 62, 0, 10),
                Text     = d.N,
                TextColor3 = C.white,
                Font     = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                ZIndex   = 9,
            })

            -- Category label
            mkLabel(card, {
                Size     = UDim2.new(1, -100, 0, 14),
                Position = UDim2.new(0, 62, 0, 34),
                Text     = (d.Cat or "Universal"):upper(),
                TextColor3 = C.muted,
                Font     = Enum.Font.GothamBold,
                TextSize = 9,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex   = 9,
            })

            -- Right: NEW badge or chevron
            if d.New then
                local badge = mkFrame(card, {
                    Size     = UDim2.new(0, 38, 0, 18),
                    Position = UDim2.new(1, -48, 0.5, -9),
                    BackgroundColor3 = C.red,
                    ZIndex   = 10,
                })
                corner(badge, 9)
                mkLabel(badge, {
                    Size = UDim2.new(1,0,1,0),
                    Text = "NEW",
                    TextColor3 = Color3.new(1,1,1),
                    Font = Enum.Font.GothamBold,
                    TextSize = 9,
                    ZIndex = 11,
                })
            else
                mkLabel(card, {
                    Size     = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    Text     = "›",
                    TextColor3 = C.muted,
                    Font     = Enum.Font.GothamBold,
                    TextSize = 20,
                    ZIndex   = 9,
                })
            end

            -- Interactions
            card.MouseEnter:Connect(function()
                tw(card, 0.14, nil, nil, {BackgroundColor3 = C.cardHov})
            end)
            card.MouseLeave:Connect(function()
                tw(card, 0.14, nil, nil, {BackgroundColor3 = C.card})
            end)
            card.MouseButton1Down:Connect(function()
                twSpring(card, 0.08, {Size = UDim2.new(1, -4, 0, CARD_H - 3)})
            end)
            card.MouseButton1Up:Connect(function()
                twSpring(card, 0.15, {Size = UDim2.new(1, 0, 0, CARD_H)})
            end)
            card.MouseButton1Click:Connect(function()
                play("tap")
                if settingsOpen then
                    settingsOpen = false
                    tw(SettingsPanel, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In,
                       {Position = SET_HIDE})
                end
                if panelOpen then
                    closePanel(function()
                        task.wait(0.08)
                        openPanel(d)
                    end)
                else
                    openPanel(d)
                end
            end)
        end
    end

    -- Empty state
    if i == 0 then
        EmptyLabel.Visible = true
        EmptyLabel.Text = q ~= "" and ("No results for \"" .. SearchBox.Text .. "\"")
                                    or "No scripts in this category"
        EmptyLabel.LayoutOrder = 1
        EmptyLabel.Parent = Scroll
    else
        EmptyLabel.Visible = false
    end
end

