    table.insert(toastStack, card)

    -- Slide in
    tw(card, 0.38, { Position = UDim2.new(1, -316, 1, -90) }, Enum.EasingStyle.Back)
    -- Drain progress
    tw(fill, 3.4, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)

    task.delay(3.5, function()
        if card and card.Parent then
            tw(card, 0.26, { Position = UDim2.new(1, 18, 1, -90) },
               Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.wait(0.28)
            for i, v in ipairs(toastStack) do
                if v == card then table.remove(toastStack, i); break end
            end
            pcall(function() card:Destroy() end)
        end
    end)
end

