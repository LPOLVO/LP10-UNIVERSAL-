    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Semicolon or
       (inp.KeyCode == Enum.KeyCode.K and UIS:IsKeyDown(Enum.KeyCode.LeftControl)) then
        if cmdOpen then closeCmd() else openCmd() end
    end
    if inp.KeyCode == Enum.KeyCode.Escape and cmdOpen then
        closeCmd()
    end
end)

