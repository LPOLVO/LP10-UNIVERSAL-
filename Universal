local function buildLibrary(page)
    local names = {
        Scripts  = "Script Library",
        Favorites= "Favorites",
        Pinned   = "Pinned Scripts",
        Recent   = "Recently Executed",
    }
    PageTitle.Text = names[page] or "Script Library"
    PageSub.Text   = page == "Scripts"
        and SCRIPT_COUNT.." scripts  ·  tap to inspect before executing"
        or "Your curated LP10 collection."

    local all   = getList(page)
    local query = SearchBox.Text:lower()
    local shown = 0

    for _, d in ipairs(all) do
        local matchSearch = query == "" or d.N:lower():find(query,1,true)
        local matchCat    = CurrentCat == "All"
            or (CurrentCat == "New" and d.New)
            or (d.Cat == CurrentCat)
        if matchSearch and matchCat then
            shown = shown + 1
            buildCard(Body, d, shown)
        end
    end

    if shown == 0 then
        lbl(Body, {
            Size=UDim2.new(1,0,0,100),
            Text=query ~= ""
                and ('No results for "'..SearchBox.Text..'"')
                or "Nothing here yet.",
            TextColor3=C.muted, Font=Enum.Font.GothamSemibold,
            TextSize=13, TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Center,
            LayoutOrder=1, ZIndex=14,
        })
    end
end

