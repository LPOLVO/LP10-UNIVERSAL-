-- REFRESH & NAVIGATION
-- ════════════════════════════════════════════════════════════════════════════
local CurrentPage = Persist.page or "Home"

local function refresh()
    wipeBody()
    if     CurrentPage == "Home"      then buildHome()
    elseif CurrentPage == "Games"     then buildGames()
    elseif CurrentPage == "Changelog" then buildChangelog()
    elseif CurrentPage == "Settings"  then buildSettings()
    elseif CurrentPage == "About"     then buildAbout()
    else                                   buildLibrary(CurrentPage)
    end
    -- Update nav button states
    for id, btn in pairs(NavButtons) do
        local active = id == CurrentPage
        btn.BackgroundColor3 = active and Color3.fromRGB(24,48,108) or Color3.fromRGB(7,11,24)
        for _, ch in ipairs(btn:GetChildren()) do
            if ch:IsA("TextLabel") then
                ch.TextColor3 = active and C.white or C.text
            end
        end
    end
end

local function changePage(id)
    CurrentPage = id
    Persist.page = id
    SearchBox.Text = ""
    SearchClear.Visible = false
    Body.CanvasPosition = Vector2.new(0,0)
    play("slide")
    refresh()
end

-- Expose to global for cross-scope calls
_G.LP10ChangePage = changePage
_G.LP10Refresh    = refresh

