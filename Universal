-- FILE-BACKED USAGE VAULT
-- Keeps execution totals, most-used ranking, and recent scripts between
-- executor restarts when the executor exposes its local file API.
-- ════════════════════════════════════════════════════════════════════════════
local UsageFile       = "LP10/UniversalUsage.json"
local UsageFileBackup = "LP10_UniversalUsage.json"

local function readUsageFile()
    if type(readfile) ~= "function" then return nil end
    for _, path in ipairs({UsageFile, UsageFileBackup}) do
        local ok, raw = pcall(function()
            if type(isfile) == "function" and not isfile(path) then
                return nil
            end
            return readfile(path)
        end)
        if ok and type(raw) == "string" and raw ~= "" then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(raw) end)
            if type(decoded) == "table" then return decoded end
        end
    end
end

local function mergeUsageFromDisk(data)
    if type(data) ~= "table" then return end
    Persist.execCount = math.max(tonumber(Persist.execCount) or 0, tonumber(data.execCount) or 0)

    if type(data.totalExecs) == "table" then
        for name, count in pairs(data.totalExecs) do
            local diskCount = tonumber(count) or 0
            Persist.totalExecs[name] = math.max(tonumber(Persist.totalExecs[name]) or 0, diskCount)
        end
    end

    if type(data.lastUsed) == "table" then
        for name, stamp in pairs(data.lastUsed) do
            if Persist.lastUsed[name] == nil then
                Persist.lastUsed[name] = stamp
            end
        end
    end

    if #Persist.recent == 0 and type(data.recent) == "table" then
        for _, name in ipairs(data.recent) do
            if type(name) == "string" and #Persist.recent < 12 then
                local exists = false
                for _, current in ipairs(Persist.recent) do
                    if current == name then exists = true; break end
                end
                if not exists then table.insert(Persist.recent, name) end
            end
        end
    end

    for _, listName in ipairs({"favorites", "pinned"}) do
        if #Persist[listName] == 0 and type(data[listName]) == "table" then
            for _, name in ipairs(data[listName]) do
                if type(name) == "string" then table.insert(Persist[listName], name) end
            end
        end
    end
end

local function saveUsageFile()
    if type(writefile) ~= "function" then return false end
    local payload = {
        version    = 1,
        updatedAt  = os.time(),
        execCount  = Persist.execCount or 0,
        totalExecs = Persist.totalExecs or {},
        recent     = Persist.recent or {},
        lastUsed   = Persist.lastUsed or {},
        favorites  = Persist.favorites or {},
        pinned     = Persist.pinned or {},
    }
    local encoded
    local okEncode = pcall(function() encoded = HttpService:JSONEncode(payload) end)
    if not okEncode or type(encoded) ~= "string" then return false end

    local folderReady = false
    pcall(function()
        if type(isfolder) == "function" and isfolder("LP10") then
            folderReady = true
        elseif type(makefolder) == "function" then
            makefolder("LP10")
            folderReady = true
        end
    end)

    local path = folderReady and UsageFile or UsageFileBackup
    return pcall(function() writefile(path, encoded) end)
end

-- Load disk data after the in-memory defaults exist.  If the executor has no
-- file API, getgenv persistence still keeps the session data available.
mergeUsageFromDisk(readUsageFile())

