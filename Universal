local Milestones = {
    {threshold=1,   title="First Exec",     msg="You executed your first script. The journey begins.",    col=C.electric},
    {threshold=5,   title="Script Explorer",msg="5 executions. You're getting the hang of LP10.",         col=C.electric},
    {threshold=10,  title="Power User",     msg="10 executions. You're officially a power user.",          col=C.violet},
    {threshold=25,  title="Script Master",  msg="25 executions. LP10 Ultimate has chosen you.",            col=C.yellow},
    {threshold=50,  title="Elite Operator", msg="50 executions. You are the definition of Elite.",         col=C.green},
    {threshold=100, title="LP10 Legend",    msg="100 executions. Legend status — @LPOLVO would be proud.", col=C.pink},
    {threshold=3,   title="Curator",        msg="3 favorites saved. Your collection is taking shape.",     col=C.yellow, fav=true},
    {threshold=5,   title="Collector",      msg="5 pinned scripts. Pin master achieved.",                  col=C.ice,    pin=true},
}

local function checkMilestones()
    for _, m in ipairs(Milestones) do
        local count = m.fav and #Persist.favorites
                   or m.pin and #Persist.pinned
                   or (Persist.execCount or 0)
        local key   = "ach_"..m.title
        if count >= m.threshold and not Persist[key] then
            Persist[key] = true
            task.delay(0.5, function()
                toast("🏆 "..m.title, m.msg, m.col)
            end)
        end
    end
end

-- Hook milestone check into execScript
local _origExec = execScript
execScript = function(data)
    _origExec(data)
    task.delay(0.8, checkMilestones)
end

