    local narrow = vp.X < 660
    Side.Visible          = not narrow
    Content.Position      = narrow and UDim2.fromOffset(0,62) or UDim2.fromOffset(160,62)
    Content.Size          = narrow and UDim2.new(1,0,1,-62) or UDim2.new(1,-160,1,-62)
    BrandTitle.Visible    = not narrow
    BrandSub.Visible      = not narrow
    LiveStats.Visible     = vp.X > 680
    ClockLabel.Visible    = vp.X > 680
end

