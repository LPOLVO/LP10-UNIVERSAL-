-- NOTIFICATION CENTER  (history of last 10 toasts)
-- ════════════════════════════════════════════════════════════════════════════
local NotifHistory = {}
local MAX_NOTIF_HISTORY = 10

local _origToast = toast
toast = function(title, msg, col)
    table.insert(NotifHistory, 1, {title=title, msg=msg, col=col, time=os.date("%H:%M:%S")})
    if #NotifHistory > MAX_NOTIF_HISTORY then
        table.remove(NotifHistory, #NotifHistory)
    end
    _origToast(title, msg, col)
end

local function buildNotifCenter()
    PageTitle.Text = "Notifications"
    PageSub.Text   = "Recent system messages and alerts."
    if #NotifHistory == 0 then
        label(Body, {
            Size=UDim2.new(1,0,0,60), LayoutOrder=1,
            Text="No notifications yet.",
            TextColor3=C.muted, Font=Enum.Font.Gotham, TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Center, ZIndex=16,
        })
        return
    end
    for i, n in ipairs(NotifHistory) do
        local row = frame(Body, {
            Size=UDim2.new(1,0,0,60), BackgroundColor3=C.card, LayoutOrder=i, ZIndex=16,
        })
        round(row, 13)
        outline(row, n.col or C.line, 1)
        frame(row, {Size=UDim2.fromOffset(3,36), Position=UDim2.fromOffset(10,12), BackgroundColor3=n.col or C.electric, ZIndex=17})
        label(row, {
            Size=UDim2.new(1,-42,0,20), Position=UDim2.fromOffset(26,8),
            Text=n.title, TextColor3=C.white, Font=Enum.Font.GothamBold, TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=17,
        })
        label(row, {
            Size=UDim2.new(1,-120,0,16), Position=UDim2.fromOffset(26,30),
            Text=n.msg, TextColor3=C.text, Font=Enum.Font.Gotham, TextSize=9,
            TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=17,
        })
        label(row, {
            Size=UDim2.fromOffset(80,16), Position=UDim2.new(1,-90,0,22),
            Text=n.time, TextColor3=C.dim, Font=Enum.Font.Gotham, TextSize=8,
            TextXAlignment=Enum.TextXAlignment.Right, ZIndex=17,
        })
    end
end

