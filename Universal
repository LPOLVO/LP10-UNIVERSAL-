-- ════════════════════════════════════════════════════════════════════════════
local lastExecTime = {}

local _guardedExec = execScript
execScript = function(data)
    if not data then return end
    local now = os.clock()
    if lastExecTime[data.N] and (now - lastExecTime[data.N]) < 1.2 then
        toast("Wait", "Please wait before executing this script again.", C.yellow)
        return
    end
    lastExecTime[data.N] = now
    _guardedExec(data)
end

