-- ║  LIVE STATS (FPS / PING / MEM)                                           ║
-- ╚══════════════════════════════════════════════════════════════════════════╝
local _fpsFrames, _fpsElapsed, _fpsVal = 0, 0, 60
RunService.Heartbeat:Connect(function(dt)
    _fpsFrames  = _fpsFrames  + 1
    _fpsElapsed = _fpsElapsed + dt
    if _fpsElapsed >= (Cfg.performance and 1.0 or 0.5) then
        _fpsVal              = math.floor(_fpsFrames / _fpsElapsed)
        _fpsFrames, _fpsElapsed = 0, 0
        local ping, mem = 0, 0
        pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        pcall(function() mem  = math.floor(Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Gui)) end)
        HdrStats.Text       = "FPS "..tostring(_fpsVal).."    PING "..math.floor(ping).."ms    MEM "..mem.."MB"
        HdrStats.TextColor3 = _fpsVal >= 55 and C.green or (_fpsVal >= 30 and C.yellow or C.red)
        HdrClock.Text       = GAME_NAME.."  /  "..os.date("%H:%M:%S")
        if _fpsVal < 25 then Cfg.particles = false end
    end
end)

-- ╔══════════════════════════════════════════════════════════════════════════╗
-- ║  ELECTRIC GLOW ON TEXT                                                   ║
-- ╚══════════════════════════════════════════════════════════════════════════╝
local _ePhase, _eAccum = 0, 0
RunService.Heartbeat:Connect(function(dt)
    _ePhase = _ePhase + dt * (Cfg.reduceMotion and 1.2 or 3.6)
    _eAccum = _eAccum + dt
    if _eAccum < (Cfg.performance and 0.15 or 0.07) then return end
    _eAccum = 0
    local pulse = 0.44 + ((math.sin(_ePhase) + 1) * 0.5) * 0.30
    for i = #GlowTargets, 1, -1 do
        local t = GlowTargets[i]
        if t and t.Parent then
            t.TextStrokeColor3       = Cfg.glowFX and C.electric or t.TextColor3
            t.TextStrokeTransparency = Cfg.glowFX and pulse or 1
        else
            table.remove(GlowTargets, i)
        end
    end
end)

