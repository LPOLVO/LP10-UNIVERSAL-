local function wipe()
    for _, c in ipairs(Body:GetChildren()) do
        if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            c:Destroy()
        end
    end
end

local function getList(page)
    local out = {}
    if page == "Favorites" then
        for _, n in ipairs(Persist.favs) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(out,d) end end
        end
    elseif page == "Pinned" then
        for _, n in ipairs(Persist.pinned) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(out,d) end end
        end
    elseif page == "Recent" then
        for _, n in ipairs(Persist.recent) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(out,d) end end
        end
    else
        for _, d in ipairs(Scripts) do table.insert(out,d) end
    end
    return out
end

