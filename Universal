-- SCREEN SIZE HELPERS
-- ════════════════════════════════════════════════════════════
local function getVP()
    return Camera.ViewportSize
end

local function isMobile()
    return UIS.TouchEnabled and not UIS.MouseEnabled
end

local function getWinSize()
    local vp = getVP()
    if vp.X < 600 then
        -- phone portrait
        return math.floor(vp.X * 0.85), math.floor(vp.Y * 0.78)
    elseif vp.X < 1024 then
        -- tablet
        return math.min(math.floor(vp.X * 0.72), 560), math.min(math.floor(vp.Y * 0.80), 650)
    else
        -- PC
        return 440, 580
    end
end

local WIN_W, WIN_H = getWinSize()

-- ════════════════════════════════════════════════════════════
-- TWEEN HELPER
-- ════════════════════════════════════════════════════════════
local function tw(obj, t, sty, dir, props)
    local speed = Settings.reduceMotion and math.min(t, 0.15) or (t * (1 / math.max(Settings.animSpeed, 0.1)))
    local info  = TweenInfo.new(speed, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

local function twSpring(obj, t, props)
    return tw(obj, t, Enum.EasingStyle.Back, Enum.EasingDirection.Out, props)
end

local function twElastic(obj, t, props)
    return tw(obj, t, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, props)
end

-- ════════════════════════════════════════════════════════════
-- INSTANCE HELPERS
-- ════════════════════════════════════════════════════════════
local function mk(cls, parent, props)
    local inst = Instance.new(cls)
    if parent then inst.Parent = parent end
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function mkFrame(parent, props)
    local f = mk("Frame", parent, props)
    f.BorderSizePixel = 0
    return f
end

local function mkLabel(parent, props)
    local l = mk("TextLabel", parent, props)
    l.BackgroundTransparency = 1
    l.TextWrapped = props and props.TextWrapped or false
    return l
end

local function mkBtn(parent, props)
    local b = mk("TextButton", parent, props)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    return b
end

local function mkImg(parent, props)
    local i = mk("ImageLabel", parent, props)
    i.BackgroundTransparency = 1
    return i
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 12)
    c.Parent = p
    return c
end

local function stroke(p, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or C.border
    s.Thickness = th or 1.5
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

local function gradient(p, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c0),
        ColorSequenceKeypoint.new(1, c1),
    })
    g.Rotation = rot or 90
    g.Parent = p
    return g
end

local function gradientTrans(p, t0, t1, rot)
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, t0),
        NumberSequenceKeypoint.new(1, t1),
    })
    g.Rotation = rot or 90
    g.Parent = p
    return g
end

local function padding(p, l, r, t, b)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft   = UDim.new(0, l or 0)
    pad.PaddingRight  = UDim.new(0, r or 0)
    pad.PaddingTop    = UDim.new(0, t or 0)
    pad.PaddingBottom = UDim.new(0, b or 0)
    pad.Parent = p
    return pad
end

-- Glow image (soft radial)
local GLOW_IMG = "rbxassetid://5028857084"
local CIRCLE_IMG = "rbxassetid://3570695787"

local function mkGlow(parent, size, col, trans)
    local g = mkImg(parent, {
        Image = GLOW_IMG,
        Size  = UDim2.new(0, size, 0, size),
        Position = UDim2.new(0.5, -size/2, 0.5, -size/2),
        ImageColor3 = col or C.royal,
        ImageTransparency = trans or 0.6,
        ZIndex = (parent.ZIndex or 1) + 1,
    })
    return g
end

