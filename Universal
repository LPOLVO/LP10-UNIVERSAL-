    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        _drag     = true
        _dragStart= i.Position
        _dragPos  = Main.Position
        _lastPos  = i.Position
        _velX, _velY = 0, 0
    end
end)

UIS.InputChanged:Connect(function(i)
    if not _drag then return end
    if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
        local d  = i.Position - _dragStart
        _velX = i.Position.X - _lastPos.X
        _velY = i.Position.Y - _lastPos.Y
        _lastPos = i.Position
        Main.Position = UDim2.new(
            _dragPos.X.Scale, _dragPos.X.Offset + d.X,
            _dragPos.Y.Scale, _dragPos.Y.Offset + d.Y
        )
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if _drag then
            _drag = false
            -- Apply momentum
            if (math.abs(_velX) > 2 or math.abs(_velY) > 2) and not Settings.reduceMotion then
                local cp = Main.Position
                tw(Main, 0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, {
                    Position = UDim2.new(cp.X.Scale, cp.X.Offset + _velX * 5,
                                         cp.Y.Scale, cp.Y.Offset + _velY * 5)
                })
            end
        end
    end
end)

