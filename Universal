-- STATS / CLOCK
-- ════════════════════════════════════════════════════════════
local fps, frames, elapsed, ping = 60, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
    frames  = frames  + 1
    elapsed = elapsed + dt
    if elapsed >= (Settings2.performance and 1 or 0.5) then
        fps             = math.floor(frames / elapsed)
        frames, elapsed = 0, 0
        pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
        local memory = 0
        pcall(function() memory = math.floor(game:GetService("Stats"):GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Gui)) end)
        Stats.Text       = "FPS " .. fps .. "    PING " .. math.floor(ping) .. "ms    MEM " .. memory .. "MB"
        Stats.TextColor3 = fps >= 55 and C.green or (fps >= 30 and C.yellow or C.red)
        Clock.Text       = CURRENT_GAME .. "  /  " .. os.date("%H:%M:%S")
        if fps < 30 then Settings2.particles = false end
    end
end)

-- ════════════════════════════════════════════════════════════
-- ELECTRIC GLOW ANIMATION
-- ════════════════════════════════════════════════════════════
local electricPhase       = 0
local electricAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
    electricPhase       = electricPhase + dt * (Settings2.reduceMotion and 1.4 or 3.8)
    electricAccumulator = electricAccumulator + dt
    if electricAccumulator < (Settings2.performance and 0.14 or 0.07) then return end
    electricAccumulator = 0
    local pulse = 0.42 + ((math.sin(electricPhase) + 1) * 0.5) * 0.28
    for index = #ElectricTextTargets, 1, -1 do
        local target = ElectricTextTargets[index]
        if target and target.Parent then
            target.TextStrokeColor3 = Settings2.glow and C.electric or target.TextColor3
            target.TextStrokeTransparency = Settings2.glow and pulse or 1
        else
            table.remove(ElectricTextTargets, index)
        end
    end
end)

