applySize = function(width, height, animate)
    local viewport = Camera.ViewportSize
    WIN_W, WIN_H = viewport.X, viewport.Y
    if not animate then
        Main.Size = UDim2.fromScale(1, 1)
        Main.Position = UDim2.fromScale(0, 0)
    end
    local narrow = WIN_W < 640
    Side.Visible = not narrow
    Content.Position = narrow and UDim2.fromOffset(0, 62) or UDim2.fromOffset(174, 62)
    Content.Size = narrow and UDim2.new(1, 0, 1, -62) or UDim2.new(1, -174, 1, -62)
    BrandTitle.Visible = not narrow
    BrandSub.Visible = not narrow
    -- The telemetry line is intentionally hidden before it can collide
    -- with the window controls on short landscape devices.
    Stats.Visible = WIN_W > 700
    Clock.Visible = WIN_W > 700
    -- Deliberately no resize handle: LP10 is locked to the viewport.
end

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    applySize(Camera.ViewportSize.X, Camera.ViewportSize.Y, false)
end)

