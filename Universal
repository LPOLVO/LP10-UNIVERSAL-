-- SCRIPT SEARCH ENGINE  (advanced search: by tag, category, name)
-- ════════════════════════════════════════════════════════════════════════════
local function searchScripts(query)
    query = query:lower():gsub("^%s+",""):gsub("%s+$","")
    if query == "" then return Scripts end
    local results = {}
    local seen    = {}
    -- 1. Exact name prefix
    for _, d in ipairs(Scripts) do
        if d.N:lower():sub(1,#query) == query and not seen[d.N] then
            table.insert(results, d); seen[d.N] = true
        end
    end
    -- 2. Name contains
    for _, d in ipairs(Scripts) do
        if d.N:lower():find(query,1,true) and not seen[d.N] then
            table.insert(results, d); seen[d.N] = true
        end
    end
    -- 3. Tag match
    if ScriptMeta then
        for _, d in ipairs(Scripts) do
            if not seen[d.N] then
                local meta = ScriptMeta[d.N]
                if meta and meta.tags then
                    for _, tag in ipairs(meta.tags) do
                        if tag:find(query,1,true) then
                            table.insert(results, d); seen[d.N] = true; break
                        end
                    end
                end
            end
        end
    end
    -- 4. Category match
    for _, d in ipairs(Scripts) do
        if not seen[d.N] and d.Cat and d.Cat:lower():find(query,1,true) then
            table.insert(results, d); seen[d.N] = true
        end
    end
    -- 5. Description match
    for _, d in ipairs(Scripts) do
        if not seen[d.N] and d.F and d.F:lower():find(query,1,true) then
            table.insert(results, d); seen[d.N] = true
        end
    end
    return results
end

-- Override buildLibrary search to use advanced engine
local _origBuildLibrary = buildLibrary
buildLibrary = function(page)
    local titles = {Scripts="Script Library",Favorites="Favorites",Pinned="Pinned Scripts",Recent="Recently Executed"}
    PageTitle.Text = titles[page] or "Script Library"
    PageSub.Text   = page=="Scripts" and "Tap a script to inspect it before executing." or "Your curated LP10 collection."

    local base  = listForPage(page)
    local query = (SearchBox.Text or ""):lower():gsub("^%s+",""):gsub("%s+$","")
    local list  = {}

    if query ~= "" then
        -- Use advanced search engine on base list
        local advanced = searchScripts(query)
        local baseSet  = {}
        for _, d in ipairs(base) do baseSet[d.N] = true end
        for _, d in ipairs(advanced) do
            if baseSet[d.N] then table.insert(list, d) end
        end
    else
        list = base
    end

    local visible = 0
    for _, data in ipairs(list) do
        local catMatch = ActiveCat == "All"
            or (ActiveCat == "New" and data.New)
            or (data.Cat == ActiveCat)
        if catMatch then
            visible = visible + 1
            scriptCard(Body, data, visible)
        end
    end

    if visible == 0 then
        label(Body, {
            Size=UDim2.new(1,0,0,110), LayoutOrder=1,
            Text=query~="" and ('No matches for "'..SearchBox.Text..'"') or
                 "Nothing here yet.\nExecute scripts to fill this collection.",
            TextColor3=C.muted, Font=Enum.Font.GothamSemibold, TextSize=13,
            TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=16,
        })
    end
end

