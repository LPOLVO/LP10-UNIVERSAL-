                t.Position.Y.Scale, t.Position.Y.Offset - 84) })
        end
    end

    local card = frm(GUI, {
        Size             = UDim2.fromOffset(300, 74),
        Position         = UDim2.new(1, 18, 1, -90),
        BackgroundColor3 = C.panel,
        ZIndex           = 120,
    })
    corner(card, 15)
    stroke(card, col, 1.2)
    grad(card, Color3.fromRGB(16, 24, 52), C.surface, 135)

    -- Left accent bar
    local acBar = frm(card, {
        Size             = UDim2.new(0, 3, 1, -18),
        Position         = UDim2.fromOffset(10, 9),
        BackgroundColor3 = col,
        ZIndex           = 121,
    })
    corner(acBar, 2)

    -- Icon circle
    local ic = frm(card, {
        Size             = UDim2.fromOffset(34, 34),
        Position         = UDim2.fromOffset(22, 20),
        BackgroundColor3 = col,
        ZIndex           = 121,
    })
    corner(ic, 999)
    lbl(ic, {
        Size=UDim2.fromScale(1,1), Text="!", TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold, TextSize=16, ZIndex=122,
    })
    glowImg(ic, 64, col, 0.72, UDim2.fromOffset(-15, -15)).ZIndex = 120

    lbl(card, {
        Size           = UDim2.new(1, -72, 0, 22),
        Position       = UDim2.fromOffset(64, 11),
        Text           = title,
        TextColor3     = C.white,
        Font           = Enum.Font.GothamBold,
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 121,
    })
    lbl(card, {
        Size           = UDim2.new(1, -72, 0, 26),
        Position       = UDim2.fromOffset(64, 32),
        Text           = msg,
        TextColor3     = C.text,
        Font           = Enum.Font.Gotham,
        TextSize       = 10,
        TextWrapped    = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 121,
    })

    -- Progress bar
    local track = frm(card, {
        Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=C.line, ZIndex=121,
    })
    corner(track, 1)
    local fill = frm(track, {
        Size=UDim2.fromScale(1,1), BackgroundColor3=col, ZIndex=122,
    })
