local function execName()
    if syn then return "Synapse X" end
    if KRNL_ENV then return "Krnl" end
    for _, fn in ipairs({getexecutorname, identifyexecutor}) do
        if fn then
            local ok, v = pcall(fn)
            if ok and v then return tostring(v) end
        end
    end
    return UIS.TouchEnabled and "Mobile Executor" or "Delta / Unknown"
end

