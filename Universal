    -- Stagger particle spawn after open
    if Settings.particles and not Settings.reduceMotion and not Settings.performanceMode then
        task.delay(0.6, function()
            for k = 1, 4 do
                task.delay(k * 0.12, function()
                    spawnParticle(GUI, 4)
                end)
            end
        end)
