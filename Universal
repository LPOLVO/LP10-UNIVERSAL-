-- LIVE PERFORMANCE HUD (FPS / PING / MEM)
-- ════════════════════════════════════════════════════════════════════════════
local _fps, _frames, _elapsed, _ping = 60, 0, 0, 0
local lowFpsStreak = 0
connectTracked(RunService.Heartbeat, function(dt)
    _frames  = _frames  + 1
    _elapsed = _elapsed + dt
    local interval = Settings.performance and 1 or 0.5
    if _elapsed >= interval then
        _fps             = math.floor(_frames / _elapsed)
        _frames, _elapsed = 0, 0
        pcall(function()
            _ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        local mem = 0
        pcall(function()
            mem = math.floor(game:GetService("Stats"):GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Gui))
        end)
        LiveStats.Text = "FPS ".._fps.."    PING "..math.floor(_ping).."ms    MEM "..mem.."MB"
        LiveStats.TextColor3 = _fps>=55 and C.green or (_fps>=30 and C.yellow or C.red)
        ClockLabel.Text = GAME_NAME.."  /  "..os.date("%H:%M:%S")
        -- Auto performance guard
        if _fps < 30 then lowFpsStreak = lowFpsStreak + 1 else lowFpsStreak = 0 end
        if lowFpsStreak >= 4 then Settings.particles = false end
    end
end)

-- ════════════════════════════════════════════════════════════════════════════
-- FLAME GLOW ANIMATION
-- ════════════════════════════════════════════════════════════════════════════
local ePhase, eAcc = 0, 0
connectTracked(RunService.Heartbeat, function(dt)
    ePhase = ePhase + dt * (Settings.reduceMotion and 1.5 or 3.8)
    eAcc   = eAcc   + dt
    if eAcc < (Settings.performance and 0.14 or 0.06) then return end
    eAcc = 0
    local pulse = 0.40 + ((math.sin(ePhase)+1)*0.5)*0.30
    for i = #ElectricTargets, 1, -1 do
        local t = ElectricTargets[i]
        if t and t.Parent then
            t.TextStrokeColor3        = Settings.glow and C.electric or t.TextColor3
            t.TextStrokeTransparency  = Settings.glow and pulse or 1
        else
            table.remove(ElectricTargets, i)
        end
    end
end)

-- Fire border animation for featured scripts
connectTracked(RunService.Heartbeat, function()
    for i = #RGBTargets, 1, -1 do
        local stroke = RGBTargets[i]
        if stroke and stroke.Parent then
            stroke.Color = C.electric:Lerp(C.violet, (math.sin(ePhase * 0.6 + i) + 1) / 2)
        else
            table.remove(RGBTargets, i)
        end
    end
end)

