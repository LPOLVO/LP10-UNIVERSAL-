local function openDetail(data)
    CurrentScript = data
    if not Detail then return end
    DetailTitle.Text = data.N
    DetailDesc.Text = data.F or "A polished LP10 Universal script. Open the experience and explore."
    DetailMeta.Text = "VERSION 5.0   /   " .. (data.Cat or "Universal"):upper() .. "   /   DELTA + MOBILE + PC"
    DetailFav.Text = has(Persist.favorites, data.N) and "FAVORITED" or "FAVORITE"
    DetailPin.Text = has(Persist.pinned, data.N) and "PINNED" or "PIN"
    Detail.Visible = true
    spring(Detail, 0.42, {Position = UDim2.new(0, 0, 0, 0)})
end

local function executeScript(data)
    if not data or not data.S then return end
    play("exec")
    remember(Persist.recent, data.N, 12)
    remember(Persist.recentGames, CURRENT_GAME, 8)
    log(data.N)
    toast("Executing script", data.N, C.green)
    task.wait(0.28)
    closeDetail()
    tween(Main, 0.3, {Size = UDim2.fromOffset(0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    if Blur.Enabled then tween(Blur, 0.3, {Size = 0}) end
    task.wait(0.34)
    pcall(function()
        if Blur then Blur.Enabled = false end
        if GUI then GUI:Destroy() end
    end)
    -- Existing execution contract intentionally preserved.
    loadstring(data.S)()
end

