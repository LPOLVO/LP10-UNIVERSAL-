    wipeBody()
    if     CurrentPage == "Home"      then buildHome()
    elseif CurrentPage == "Games"     then buildGames()
    elseif CurrentPage == "Changelog" then buildChangelog()
    elseif CurrentPage == "Settings"  then buildSettings()
    elseif CurrentPage == "About"     then buildAbout()
    else buildLibrary(CurrentPage) end

    for id, item in pairs(NavButtons) do
        local active = id == CurrentPage
        item.BackgroundColor3 = active and Color3.fromRGB(26, 52, 112) or Color3.fromRGB(7, 11, 24)
        for _, child in ipairs(item:GetChildren()) do
            if child:IsA("TextLabel") then
                child.TextColor3 = active
                    and (child.Position.X.Offset < 30 and C.ice   or C.white)
                    or  (child.Position.X.Offset < 30 and C.muted or C.text)
            end
        end
    end
end

