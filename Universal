-- SCRIPT EXECUTION ENGINE
-- ════════════════════════════════════════════════════════════════════════════
local CurrentScript = nil
local lastExecTime = {}
local detailToken = 0

local function execScript(data)
    if not data then return end
    local now = os.clock()
    if lastExecTime[data.N] and (now - lastExecTime[data.N]) < 1.2 then
        toast("Wait", "Please wait before casting this script again.", C.yellow)
        return
    end
    lastExecTime[data.N] = now

    if haptic then haptic(0.55) end
    play("exec")
    addRecent(data.N)
    Persist.execCount = (Persist.execCount or 0) + 1
    Persist.totalExecs[data.N] = (Persist.totalExecs[data.N] or 0) + 1
    Persist.lastUsed[data.N] = os.time()
    saveUsageFile()

    -- Update recent games
    if GAME_NAME ~= "Unknown Experience" then
        for i, g in ipairs(Persist.recentGames) do
            if g == GAME_NAME then table.remove(Persist.recentGames, i); break end
        end
        if #Persist.recentGames >= 10 then
            table.remove(Persist.recentGames, #Persist.recentGames)
        end
        table.insert(Persist.recentGames, 1, GAME_NAME)
    end

    toast("Casting spell", data.N, C.electric)

    task.spawn(function()
        local ok, err = pcall(function()
            local compile = loadstring or load
            local fn, compileErr = compile(data.S)
            if not fn then error(compileErr or "script failed to compile", 0) end
            fn()
        end)
        if ok then
            task.delay(0.6, function()
                toast("Done", data.N.." executed successfully.", C.green)
            end)
            if checkMilestones then task.delay(0.8, checkMilestones) end
            if showRating then task.delay(2.5, function() showRating(data) end) end
        else
            toast("Cursed!", tostring(err):sub(1,80), C.red)
        end
    end)
end

