local function openDetail(data)
    CurrentScript = data
    DetailOpen    = true
    play("slide")

    DetailTitle.Text = data.N
    DetailMeta.Text  = (data.Cat or "Universal"):upper() .. "   /   LP10 NEXUS"
    DetailDesc.Text  = data.F or "Execute this script and discover what it can do."
    DetailNewBadge.Visible = data.New == true

    -- Fav / Pin state
    local isFav  = false
    local isPin  = false
    for _, v in ipairs(Persist.favs)   do if v == data.N then isFav  = true end end
    for _, v in ipairs(Persist.pinned) do if v == data.N then isPin  = true end end
    DetailFav.Text  = isFav  and "★ FAVORITED" or "☆ FAVORITE"
    DetailFav.TextColor3 = isFav and C.yellow or C.muted
    DetailPin.Text  = isPin  and "⊞ PINNED"   or "⊟ PIN"
    DetailPin.TextColor3 = isPin and C.ice   or C.muted

    Detail.Visible   = true
    Detail.Position  = UDim2.new(1, 20, 0, 64)
    spring(Detail, 0.40, { Position=UDim2.new(0,0,0,64) })
end

