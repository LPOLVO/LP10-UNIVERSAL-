    if enter and CmdInput.Text ~= "" then
        local q = CmdInput.Text:lower()
        local found = nil
        for _, d in ipairs(Scripts) do
            if d.N:lower():find(q, 1, true) then found = d; break end
        end
        if found then
            closeCmd()
            task.delay(0.08, function() openDetail(found) end)
        else
            toast("Not Found", '"'..CmdInput.Text..'"'..": no matching script.", C.red)
        end
    else
        closeCmd()
    end
end)

connectTracked(UIS.InputBegan, function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Semicolon or
       (inp.KeyCode == Enum.KeyCode.K and UIS:IsKeyDown(Enum.KeyCode.LeftControl)) then
        if cmdOpen then closeCmd() else openCmd() end
    end
    if inp.KeyCode == Enum.KeyCode.Escape and cmdOpen then
        closeCmd()
    end
end)

