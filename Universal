local function scriptIndex(data)
    for index, item in ipairs(Scripts) do
        if item == data or item.N == data.N then return index end
    end
    return nil
end

local function has(list, name)
    for _, item in ipairs(list) do if item == name then return true end end
    return false
end

local function flip(list, name)
    for index, item in ipairs(list) do
        if item == name then table.remove(list, index); return false end
    end
    table.insert(list, name)
    return true
end

local function remember(list, name, limit)
    for index = #list, 1, -1 do
        if list[index] == name then table.remove(list, index) end
    end
    table.insert(list, 1, name)
    while #list > (limit or 12) do table.remove(list) end
end

local function scriptIcon(data)
    if data.New        then return "*" end
    if data.Cat == "Combat"   then return "A" end
    if data.Cat == "Movement" then return "M" end
    if data.Cat == "Teleport" then return "T" end
    if data.Cat == "Utility"  then return "U" end
    if data.Cat == "Visual"   then return "V" end
    return "L"
end

